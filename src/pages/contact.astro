---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---
<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Contact — ${SITE_TITLE}`}
			description="Get in touch with Saurabh Pant for telecom consulting, speaking opportunities, collaborations, or general inquiries."
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="page-header">
				<h1>Get In Touch</h1>
				<p class="subtitle">
					Whether you want to discuss telecom strategy, explore collaboration, 
					or just connect — I'd love to hear from you.
				</p>
			</section>

			<div class="contact-layout">

				<!-- CONTACT REASONS -->
				<section class="contact-reasons">
					<h2>How Can I Help?</h2>

					<div class="reason-card">
						<span class="reason-icon">💼</span>
						<div>
							<h3>Consulting & Advisory</h3>
							<p>OSS/BSS transformation, 5G strategy, MVNO architecture, or build-vs-buy decisions.</p>
						</div>
					</div>

					<div class="reason-card">
						<span class="reason-icon">🎤</span>
						<div>
							<h3>Speaking & Panels</h3>
							<p>Available for telecom conferences, industry panels, webinars, and podcast appearances.</p>
						</div>
					</div>

					<div class="reason-card">
						<span class="reason-icon">✍️</span>
						<div>
							<h3>Collaboration & Research</h3>
							<p>Interested in co-authoring articles, contributing to industry research, or joint projects.</p>
						</div>
					</div>

					<div class="reason-card">
						<span class="reason-icon">🤝</span>
						<div>
							<h3>General Connect</h3>
							<p>Always open to connecting with telecom professionals, researchers, and industry leaders.</p>
						</div>
					</div>
				</section>

				<!-- CONTACT DETAILS -->
				<section class="contact-details">
					<h2>Connect With Me</h2>

					<div class="contact-links">

						<a href="https://www.linkedin.com/in/saurabh-pant-67b67a10/" target="_blank" class="contact-link linkedin">
							<svg viewBox="0 0 16 16" width="24" height="24" fill="currentColor">
								<path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.248V6.169H2.542v7.225h2.401zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016a5.54 5.54 0 0 1 .016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4z"/>
							</svg>
							<div>
								<span class="link-label">LinkedIn</span>
								<span class="link-value">saurabh-pant-67b67a10</span>
							</div>
						</a>

						<a href="https://x.com/saurabh_pant" target="_blank" class="contact-link twitter">
							<svg viewBox="0 0 16 16" width="24" height="24" fill="currentColor">
								<path d="M12.6.75h2.454l-5.36 6.142L16 15.25h-4.937l-3.867-5.07-4.425 5.07H.316l5.733-6.57L0 .75h5.063l3.495 4.633L12.601.75Zm-.86 13.028h1.36L4.323 2.145H2.865z"/>
							</svg>
							<div>
								<span class="link-label">X (Twitter)</span>
								<span class="link-value">@saurabh_pant</span>
							</div>
						</a>

						<a href="https://scholar.google.com" target="_blank" class="contact-link scholar">
							<svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
								<path d="M12 24a7 7 0 1 1 0-14 7 7 0 0 1 0 14zm0-24L0 9.5l4.838 3.94A8 8 0 0 1 12 9a8 8 0 0 1 7.162 4.44L24 9.5z"/>
							</svg>
							<div>
								<span class="link-label">Google Scholar</span>
								<span class="link-value">Academic Publications</span>
							</div>
						</a>

					</div>

					<!-- LOCATION -->
					<div class="location-card">
						<h3>📍 Based In</h3>
						<p>Denver Metropolitan Area, Colorado, USA</p>
						<p class="timezone">Mountain Time (MT) | UTC-7</p>
					</div>

					<!-- RESPONSE TIME -->
					<div class="response-card">
						<h3>⏱️ Response Time</h3>
						<p>I typically respond to LinkedIn messages within <strong>2-3 business days</strong>. For speaking or consulting inquiries, please include relevant details about your project or event.</p>
					</div>

				</section>

			</div>

		</main>
		<Footer />
	</body>
</html>

<style>
	main { max-width: 960px; margin: 0 auto; padding: 2rem 1rem; }
	.page-header { text-align: center; padding: 2rem 0; border-bottom: 2px solid #eee; margin-bottom: 2rem; }
	.page-header h1 { font-size: 2.2rem; margin-bottom: 0.5rem; }
	.subtitle { color: #666; font-size: 1.1rem; max-width: 600px; margin: 0 auto; }
	.contact-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; }
	@media (max-width: 720px) { .contact-layout { grid-template-columns: 1fr; } }
	.contact-reasons h2, .contact-details h2 { font-size: 1.4rem; margin-bottom: 1.5rem; padding-bottom: 0.5rem; border-bottom: 1px solid #eee; }
	.reason-card { display: flex; gap: 1rem; align-items: flex-start; padding: 1rem; border-radius: 8px; margin-bottom: 1rem; background: #fafafa; border: 1px solid #eee; }
	.reason-icon { font-size: 1.5rem; }
	.reason-card h3 { font-size: 1rem; margin: 0 0 0.25rem; }
	.reason-card p { color: #555; font-size: 0.9rem; margin: 0; }
	.contact-links { display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1.5rem; }
	.contact-link { display: flex; align-items: center; gap: 1rem; padding: 1rem 1.25rem; border-radius: 8px; text-decoration: none; border: 1px solid #e0e0e0; transition: transform 0.2s; }
	.contact-link:hover { transform: translateX(4px); }
	.contact-link.linkedin { background: #f0f7ff; color: #0077b5; border-color: #0077b5; }
	.contact-link.twitter { background: #f8f8f8; color: #000; border-color: #000; }
	.contact-link.scholar { background: #f0fdf4; color: #166534; border-color: #166534; }
	.link-label { display: block; font-weight: bold; font-size: 0.95rem; }
	.link-value { display: block; font-size: 0.8rem; opacity: 0.7; }
	.location-card, .response-card { background: #f8fafc; border-radius: 8px; padding: 1.25rem; margin-bottom: 1rem; }
	.location-card h3, .response-card h3 { font-size: 1rem; margin: 0 0 0.5rem; }
	.location-card p, .response-card p { color: #555; font-size: 0.9rem; margin: 0; }
	.timezone { color: #888 !important; font-size: 0.8rem !important; margin-top: 0.25rem !important; }
</style>

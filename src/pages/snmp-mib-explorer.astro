---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---
<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`SNMP MIB Explorer — ${SITE_TITLE}`}
			description="Browse and search standard SNMP MIBs and OIDs. Look up any OID, explore MIB trees, and get AI-powered plain English explanations. Free tool for network and telecom engineers."
		/>
	</head>
	<body>
		<Header />
		<main>

			<section class="page-header">
				<div class="page-header-inner">
					<div class="page-label">Interactive Tool</div>
					<h1>SNMP MIB Explorer</h1>
					<p class="subtitle">
						Search any OID or MIB name, browse standard MIB trees, and get
						AI-powered plain English explanations — built for network and
						telecom engineers.
					</p>
					<div class="header-badges">
						<span class="badge badge-blue">Standard MIBs</span>
						<span class="badge badge-green">AI Explanations</span>
						<span class="badge badge-gray">Free to Use</span>
					</div>
				</div>
			</section>

			<div class="tool-wrap">

				<!-- SEARCH ROW -->
				<div class="search-section">
					<div class="search-row">
						<input
							type="text"
							id="oid-input"
							placeholder="Search OID (e.g. 1.3.6.1.2.1.1.1) or MIB name (e.g. sysDescr, ifInOctets)"
							autocomplete="off"
						/>
						<button id="search-btn">Search</button>
					</div>
					<div class="quick-label">Quick browse by category</div>
					<div class="category-tags" id="category-tags"></div>
				</div>

				<!-- RESULTS -->
				<div id="empty-state" class="empty-state">
					<div class="empty-icon">🔍</div>
					<p>Enter an OID or MIB name above to get started</p>
					<p class="empty-hint">Try: <span class="hint-tag" onclick="quickSearch('sysDescr')">sysDescr</span> · <span class="hint-tag" onclick="quickSearch('ifInOctets')">ifInOctets</span> · <span class="hint-tag" onclick="quickSearch('1.3.6.1.2.1.1.1')">1.3.6.1.2.1.1.1</span> · <span class="hint-tag" onclick="quickSearch('bgpPeerState')">bgpPeerState</span></p>
				</div>

				<div id="result-section" style="display:none;">

					<!-- OID CARD -->
					<div class="oid-card" id="oid-card">
						<div class="oid-card-header">
							<div>
								<div class="oid-name" id="res-name"></div>
								<div class="oid-value" id="res-oid"></div>
							</div>
							<div class="oid-badges">
								<span class="badge-mib" id="res-mib"></span>
								<span class="badge-access" id="res-access"></span>
							</div>
						</div>
						<div class="oid-meta-grid">
							<div class="meta-item">
								<div class="meta-label">Type</div>
								<div class="meta-value" id="res-type"></div>
							</div>
							<div class="meta-item">
								<div class="meta-label">Status</div>
								<div class="meta-value" id="res-status"></div>
							</div>
							<div class="meta-item">
								<div class="meta-label">Category</div>
								<div class="meta-value" id="res-category"></div>
							</div>
							<div class="meta-item">
								<div class="meta-label">RFC / Standard</div>
								<div class="meta-value" id="res-rfc"></div>
							</div>
						</div>
						<div class="oid-desc-section">
							<div class="desc-label">Description</div>
							<div class="oid-desc" id="res-desc"></div>
						</div>

						<!-- MIB TREE PATH -->
						<div class="tree-path-section">
							<div class="desc-label">MIB Tree Path</div>
							<div class="tree-path" id="res-tree"></div>
						</div>

						<!-- SNMP EXAMPLE -->
						<div class="example-section">
							<div class="desc-label">Example SNMP Command</div>
							<div class="code-block" id="res-example"></div>
						</div>

						<!-- RELATED OIDs -->
						<div class="related-section" id="related-section">
							<div class="desc-label">Related OIDs</div>
							<div class="related-tags" id="res-related"></div>
						</div>
					</div>

					<!-- AI EXPLANATION -->
					<div class="ai-section">
						<div class="ai-header">
							<div class="ai-icon">🤖</div>
							<div>
								<div class="ai-title">AI Explanation</div>
								<div class="ai-subtitle">Plain English — powered by Llama 3.3 via Groq (free)</div>
							</div>
							<button class="ai-btn" id="ai-btn" onclick="getAIExplanation()">
								Explain This OID
							</button>
						</div>
						<div id="ai-output" class="ai-output" style="display:none;"></div>
						<div id="ai-loading" class="ai-loading" style="display:none;">
							<div class="ai-spinner"></div>
							<span id="ai-loading-msg">Looking up OID...</span>
						</div>
					</div>

				</div>

				<!-- MULTIPLE RESULTS -->
				<div id="multi-result" style="display:none;">
					<div class="multi-label">Multiple matches found — select one:</div>
					<div id="multi-list" class="multi-list"></div>
				</div>

				<!-- NOT FOUND -->
				<div id="not-found" class="not-found" style="display:none;">
					<div class="nf-icon">❌</div>
					<p>OID or MIB not found in local database or AI lookup.</p>
					<p class="nf-hint">Try a different OID number, MIB object name, or vendor-specific term.</p>
				</div>

			</div>

			<!-- ABOUT -->
			<section class="about-section">
				<div class="about-grid">
					<div>
						<h2>About This Tool</h2>
						<p>The SNMP MIB Explorer covers all major standard MIBs including RFC1213 (MIB-II), IF-MIB, IP-MIB, TCP-MIB, UDP-MIB, OSPF-MIB, BGP4-MIB, MPLS-MIB, and ENTITY-MIB — with telecom-relevant MIBs added progressively.</p>
						<p>The AI explanation feature uses Llama 3.3 via Groq to translate technical OID definitions into plain English context — including when you would use each OID, what the values mean, and how it relates to network operations.</p>
						<p class="tool-credit">Built by <a href="/about">Saurabh Pant</a> · <a href="/contact">Suggest an OID or MIB →</a></p>
					</div>
					<div class="mib-coverage">
						<div class="coverage-title">MIB Coverage</div>
						<div class="coverage-grid">
							<div class="cov-item">
								<span class="cov-dot green"></span>RFC1213 / MIB-II
							</div>
							<div class="cov-item">
								<span class="cov-dot green"></span>IF-MIB
							</div>
							<div class="cov-item">
								<span class="cov-dot green"></span>IP-MIB
							</div>
							<div class="cov-item">
								<span class="cov-dot green"></span>TCP-MIB
							</div>
							<div class="cov-item">
								<span class="cov-dot green"></span>UDP-MIB
							</div>
							<div class="cov-item">
								<span class="cov-dot green"></span>OSPF-MIB
							</div>
							<div class="cov-item">
								<span class="cov-dot green"></span>BGP4-MIB
							</div>
							<div class="cov-item">
								<span class="cov-dot green"></span>MPLS-MIB
							</div>
							<div class="cov-item">
								<span class="cov-dot green"></span>ENTITY-MIB
							</div>
							<div class="cov-item">
								<span class="cov-dot yellow"></span>3GPP MIBs (coming)
							</div>
							<div class="cov-item">
								<span class="cov-dot yellow"></span>Vendor MIBs (coming)
							</div>
						</div>
					</div>
				</div>
			</section>

		</main>
		<Footer />
	</body>
</html>

<style>
	main { max-width: 900px; margin: 0 auto; padding: 0 1rem 4rem; }

	/* PAGE HEADER */
	.page-header { padding: 2.5rem 0 2rem; border-bottom: 2px solid #eee; margin-bottom: 2rem; }
	.page-header-inner { max-width: 680px; }
	.page-label { font-size: 0.75rem; font-weight: bold; text-transform: uppercase; letter-spacing: 0.1em; color: #2337ff; margin-bottom: 0.75rem; }
	.page-header h1 { font-size: 2.2rem; font-weight: 700; color: #111; margin-bottom: 0.75rem; }
	.subtitle { color: #555; font-size: 1rem; line-height: 1.7; margin-bottom: 1rem; }
	.header-badges { display: flex; gap: 0.5rem; flex-wrap: wrap; }
	.badge { font-size: 0.75rem; font-weight: 600; padding: 0.25rem 0.75rem; border-radius: 20px; }
	.badge-blue { background: #dbeafe; color: #1d4ed8; }
	.badge-green { background: #dcfce7; color: #166534; }
	.badge-gray { background: #f3f4f6; color: #374151; }

	/* TOOL WRAP */
	.tool-wrap { background: #fafafa; border: 1px solid #eee; border-radius: 16px; padding: 2rem; margin-bottom: 2rem; }

	/* SEARCH */
	.search-section { margin-bottom: 1.5rem; }
	.search-row { display: flex; gap: 8px; margin-bottom: 1rem; }
	.search-row input { flex: 1; padding: 0.75rem 1rem; border: 1.5px solid #ddd; border-radius: 8px; font-size: 14px; outline: none; background: white; }
	.search-row input:focus { border-color: #2337ff; }
	.search-row button { padding: 0.75rem 1.5rem; background: #2337ff; color: white; border: none; border-radius: 8px; font-size: 14px; font-weight: bold; cursor: pointer; white-space: nowrap; }
	.search-row button:hover { background: #1a2acc; }
	.quick-label { font-size: 11px; color: #888; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.06em; font-weight: 600; }
	.category-tags { display: flex; flex-wrap: wrap; gap: 6px; }
	.cat-tag { font-size: 12px; padding: 4px 12px; background: white; border: 1px solid #ddd; border-radius: 20px; cursor: pointer; color: #555; }
	.cat-tag:hover { border-color: #2337ff; color: #2337ff; }

	/* EMPTY STATE */
	.empty-state { text-align: center; padding: 3rem 1rem; color: #888; }
	.empty-icon { font-size: 2.5rem; margin-bottom: 0.75rem; }
	.empty-state p { margin: 0 0 0.5rem; font-size: 14px; }
	.empty-hint { font-size: 13px; color: #aaa; }
	.hint-tag { color: #2337ff; cursor: pointer; background: #f0f4ff; padding: 2px 8px; border-radius: 4px; font-size: 12px; }
	.hint-tag:hover { background: #dbeafe; }

	/* OID CARD */
	.oid-card { background: white; border: 1px solid #eee; border-radius: 12px; padding: 1.5rem; margin-bottom: 1rem; }
	.oid-card-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.25rem; gap: 1rem; flex-wrap: wrap; }
	.oid-name { font-size: 1.4rem; font-weight: 700; color: #111; margin-bottom: 4px; }
	.oid-value { font-size: 0.85rem; color: #888; font-family: monospace; }
	.oid-badges { display: flex; gap: 6px; flex-wrap: wrap; }
	.badge-mib { font-size: 11px; font-weight: 600; padding: 3px 10px; border-radius: 20px; background: #f0f4ff; color: #2337ff; }
	.badge-access { font-size: 11px; font-weight: 600; padding: 3px 10px; border-radius: 20px; }
	.access-ro { background: #dcfce7; color: #166534; }
	.access-rw { background: #fef3c7; color: #92400e; }
	.access-na { background: #f3f4f6; color: #374151; }

	/* META GRID */
	.oid-meta-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 1.25rem; padding: 1rem; background: #f8f9ff; border-radius: 8px; }
	.meta-label { font-size: 10px; color: #888; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 3px; font-weight: 600; }
	.meta-value { font-size: 13px; color: #111; font-weight: 500; }

	/* DESCRIPTION */
	.oid-desc-section { margin-bottom: 1.25rem; }
	.desc-label { font-size: 11px; color: #888; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 6px; font-weight: 600; }
	.oid-desc { font-size: 13px; color: #444; line-height: 1.7; }

	/* TREE PATH */
	.tree-path-section { margin-bottom: 1.25rem; }
	.tree-path { font-size: 12px; font-family: monospace; color: #555; background: #f8f8f8; padding: 0.6rem 0.8rem; border-radius: 6px; border: 1px solid #eee; word-break: break-all; }

	/* EXAMPLE */
	.example-section { margin-bottom: 1.25rem; }
	.code-block { font-size: 12px; font-family: monospace; color: #1d4ed8; background: #eff6ff; padding: 0.75rem 1rem; border-radius: 6px; border: 1px solid #bfdbfe; word-break: break-all; }

	/* RELATED */
	.related-section { }
	.related-tags { display: flex; flex-wrap: wrap; gap: 6px; }
	.rel-tag { font-size: 12px; padding: 3px 10px; background: #f0f4ff; border: 1px solid #c7d7ff; border-radius: 20px; cursor: pointer; color: #2337ff; }
	.rel-tag:hover { background: #dbeafe; }

	/* AI SECTION */
	.ai-section { background: white; border: 1px solid #eee; border-radius: 12px; padding: 1.5rem; }
	.ai-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 0; flex-wrap: wrap; }
	.ai-icon { font-size: 1.5rem; }
	.ai-title { font-size: 1rem; font-weight: 700; color: #111; }
	.ai-subtitle { font-size: 0.8rem; color: #888; }
	.ai-btn { margin-left: auto; padding: 0.5rem 1.25rem; background: #111; color: white; border: none; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer; }
	.ai-btn:hover { background: #333; }
	.ai-btn:disabled { background: #ccc; cursor: not-allowed; }
	.ai-output { margin-top: 1rem; font-size: 13px; color: #333; line-height: 1.8; padding: 1rem; background: #f8f9ff; border-radius: 8px; border-left: 3px solid #2337ff; }
	.ai-loading { margin-top: 1rem; display: flex; align-items: center; gap: 0.75rem; color: #888; font-size: 13px; }
	.ai-spinner { width: 16px; height: 16px; border: 2px solid #ddd; border-top-color: #2337ff; border-radius: 50%; animation: spin 0.8s linear infinite; }
	@keyframes spin { to { transform: rotate(360deg); } }
	.badge-ai { background: #fef3c7; color: #92400e; font-size: 11px; font-weight: 600; padding: 3px 10px; border-radius: 20px; margin-left: 6px; }
	.badge-vendor { background: #f3e8ff; color: #6b21a8; font-size: 11px; font-weight: 600; padding: 3px 10px; border-radius: 20px; }

	/* MULTI RESULT */
	.multi-label { font-size: 13px; color: #666; margin-bottom: 0.75rem; font-weight: 600; }
	.multi-list { display: flex; flex-direction: column; gap: 6px; }
	.multi-item { padding: 0.75rem 1rem; background: white; border: 1px solid #eee; border-radius: 8px; cursor: pointer; display: flex; justify-content: space-between; align-items: center; }
	.multi-item:hover { border-color: #2337ff; background: #f0f4ff; }
	.multi-name { font-size: 14px; font-weight: 600; color: #111; }
	.multi-oid { font-size: 12px; color: #888; font-family: monospace; }
	.multi-mib { font-size: 11px; color: #2337ff; background: #f0f4ff; padding: 2px 8px; border-radius: 10px; }

	/* NOT FOUND */
	.not-found { text-align: center; padding: 2.5rem; color: #888; }
	.nf-icon { font-size: 2rem; margin-bottom: 0.75rem; }
	.not-found p { margin: 0 0 0.4rem; font-size: 14px; }
	.nf-hint { font-size: 12px; color: #aaa; }

	/* ABOUT */
	.about-section { border-top: 2px solid #eee; padding-top: 2rem; }
	.about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; }
	.about-section h2 { font-size: 1.3rem; margin-bottom: 0.75rem; }
	.about-section p { font-size: 0.9rem; color: #555; line-height: 1.7; margin-bottom: 0.75rem; }
	.tool-credit { color: #888 !important; font-size: 0.82rem !important; }
	.tool-credit a { color: #2337ff; }
	.mib-coverage { }
	.coverage-title { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: #888; margin-bottom: 0.75rem; }
	.coverage-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.4rem; }
	.cov-item { display: flex; align-items: center; gap: 6px; font-size: 12px; color: #444; }
	.cov-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
	.cov-dot.green { background: #22c55e; }
	.cov-dot.yellow { background: #f59e0b; }

	/* MOBILE */
	@media (max-width: 720px) {
		.tool-wrap { padding: 1rem; }
		.oid-meta-grid { grid-template-columns: 1fr 1fr; }
		.about-grid { grid-template-columns: 1fr; gap: 1.5rem; }
		.ai-btn { width: 100%; margin-left: 0; margin-top: 0.75rem; }
		.search-row { flex-direction: column; }
		.search-row button { width: 100%; }
	}
</style>

<script is:inline>

// ─── MIB DATABASE ─────────────────────────────────────────────────────────────
const MIBS = [
  // ── SYSTEM (RFC1213 / SNMPv2-MIB) ──
  { oid:'1.3.6.1.2.1.1.1.0', name:'sysDescr', mib:'RFC1213-MIB', type:'DisplayString', access:'read-only', status:'current', category:'System', rfc:'RFC 1213', tree:'iso.org.dod.internet.mgmt.mib-2.system.sysDescr', desc:'A textual description of the entity. This value should include the full name and version identification of the system hardware type, software operating system, and networking software.', example:'snmpget -v2c -c public <host> 1.3.6.1.2.1.1.1.0', related:['sysObjectID','sysUpTime','sysContact','sysName','sysLocation'] },
  { oid:'1.3.6.1.2.1.1.2.0', name:'sysObjectID', mib:'RFC1213-MIB', type:'OBJECT IDENTIFIER', access:'read-only', status:'current', category:'System', rfc:'RFC 1213', tree:'iso.org.dod.internet.mgmt.mib-2.system.sysObjectID', desc:"The vendor's authoritative identification of the network management subsystem contained in the entity. This value is allocated within the SMI enterprises subtree (1.3.6.1.4.1) and provides an easy and unambiguous means for determining what kind of box is being managed.", example:'snmpget -v2c -c public <host> 1.3.6.1.2.1.1.2.0', related:['sysDescr','sysUpTime','sysName'] },
  { oid:'1.3.6.1.2.1.1.3.0', name:'sysUpTime', mib:'RFC1213-MIB', type:'TimeTicks', access:'read-only', status:'current', category:'System', rfc:'RFC 1213', tree:'iso.org.dod.internet.mgmt.mib-2.system.sysUpTime', desc:'The time (in hundredths of a second) since the network management portion of the system was last re-initialized. A useful indicator of device stability and whether a reboot has occurred.', example:'snmpget -v2c -c public <host> 1.3.6.1.2.1.1.3.0', related:['sysDescr','sysObjectID','sysContact'] },
  { oid:'1.3.6.1.2.1.1.4.0', name:'sysContact', mib:'RFC1213-MIB', type:'DisplayString', access:'read-write', status:'current', category:'System', rfc:'RFC 1213', tree:'iso.org.dod.internet.mgmt.mib-2.system.sysContact', desc:'The textual identification of the contact person for this managed node, together with information on how to contact this person. If no contact information is known, the value is the zero-length string.', example:'snmpget -v2c -c public <host> 1.3.6.1.2.1.1.4.0', related:['sysName','sysLocation','sysDescr'] },
  { oid:'1.3.6.1.2.1.1.5.0', name:'sysName', mib:'RFC1213-MIB', type:'DisplayString', access:'read-write', status:'current', category:'System', rfc:'RFC 1213', tree:'iso.org.dod.internet.mgmt.mib-2.system.sysName', desc:"An administratively assigned name for this managed node. By convention, this is the node's fully-qualified domain name. If the name is unknown, the value is the zero-length string.", example:'snmpget -v2c -c public <host> 1.3.6.1.2.1.1.5.0', related:['sysContact','sysLocation','sysDescr'] },
  { oid:'1.3.6.1.2.1.1.6.0', name:'sysLocation', mib:'RFC1213-MIB', type:'DisplayString', access:'read-write', status:'current', category:'System', rfc:'RFC 1213', tree:'iso.org.dod.internet.mgmt.mib-2.system.sysLocation', desc:'The physical location of this node (e.g., telephone closet, 3rd floor). If the location is unknown, the value is the zero-length string.', example:'snmpget -v2c -c public <host> 1.3.6.1.2.1.1.6.0', related:['sysContact','sysName','sysDescr'] },

  // ── INTERFACES (IF-MIB) ──
  { oid:'1.3.6.1.2.1.2.1.0', name:'ifNumber', mib:'IF-MIB', type:'Integer32', access:'read-only', status:'current', category:'Interfaces', rfc:'RFC 2863', tree:'iso.org.dod.internet.mgmt.mib-2.interfaces.ifNumber', desc:'The number of network interfaces (regardless of their current state) present on this system.', example:'snmpget -v2c -c public <host> 1.3.6.1.2.1.2.1.0', related:['ifDescr','ifType','ifSpeed','ifOperStatus'] },
  { oid:'1.3.6.1.2.1.2.2.1.2', name:'ifDescr', mib:'IF-MIB', type:'DisplayString', access:'read-only', status:'current', category:'Interfaces', rfc:'RFC 2863', tree:'iso.org.dod.internet.mgmt.mib-2.interfaces.ifTable.ifEntry.ifDescr', desc:'A textual string containing information about the interface. This string should include the name of the manufacturer, the product name and the version of the interface hardware/software.', example:'snmpwalk -v2c -c public <host> 1.3.6.1.2.1.2.2.1.2', related:['ifType','ifSpeed','ifOperStatus','ifInOctets','ifOutOctets'] },
  { oid:'1.3.6.1.2.1.2.2.1.5', name:'ifSpeed', mib:'IF-MIB', type:'Gauge32', access:'read-only', status:'current', category:'Interfaces', rfc:'RFC 2863', tree:'iso.org.dod.internet.mgmt.mib-2.interfaces.ifTable.ifEntry.ifSpeed', desc:"An estimate of the interface's current bandwidth in bits per second. For interfaces that do not vary in bandwidth or for those where no accurate estimation can be made, this object should contain the nominal bandwidth.", example:'snmpwalk -v2c -c public <host> 1.3.6.1.2.1.2.2.1.5', related:['ifDescr','ifType','ifOperStatus','ifHighSpeed'] },
  { oid:'1.3.6.1.2.1.2.2.1.7', name:'ifAdminStatus', mib:'IF-MIB', type:'INTEGER', access:'read-write', status:'current', category:'Interfaces', rfc:'RFC 2863', tree:'iso.org.dod.internet.mgmt.mib-2.interfaces.ifTable.ifEntry.ifAdminStatus', desc:'The desired state of the interface. The testing(3) state indicates that no operational packets can be passed. Values: up(1), down(2), testing(3).', example:'snmpwalk -v2c -c public <host> 1.3.6.1.2.1.2.2.1.7', related:['ifOperStatus','ifDescr','ifSpeed'] },

// ─── CATEGORIES ───────────────────────────────────────────────────────────────
const CATEGORIES = ['System','Interfaces','IP','TCP','UDP','OSPF','BGP','MPLS','Entity/Inventory'];
const CATEGORY_ICONS = {
  'System':'🖥️', 'Interfaces':'🔌', 'IP':'🌐', 'TCP':'🔡',
  'UDP':'📨', 'OSPF':'🔄', 'BGP':'🗺️', 'MPLS':'🏷️', 'Entity/Inventory':'📦'
};

let currentOID = null;

// ─── INIT ─────────────────────────────────────────────────────────────────────
function init() {
  const tagContainer = document.getElementById('category-tags');
  CATEGORIES.forEach(cat => {
    const tag = document.createElement('span');
    tag.className = 'cat-tag';
    tag.textContent = CATEGORY_ICONS[cat] + ' ' + cat;
    tag.onclick = () => browseCategory(cat);
    tagContainer.appendChild(tag);
  });
}

// ─── SEARCH ───────────────────────────────────────────────────────────────────
function search(query) {
  if (!query.trim()) return;
  query = query.trim();

  let result = MIBS.find(m => m.oid === query);
  if (result) { showResult(result); return; }

  result = MIBS.find(m => m.name.toLowerCase() === query.toLowerCase());
  if (result) { showResult(result); return; }

  const partialMatches = MIBS.filter(m =>
    m.name.toLowerCase().includes(query.toLowerCase()) ||
    m.desc.toLowerCase().includes(query.toLowerCase()) ||
    m.oid.startsWith(query)
  );

  if (partialMatches.length === 1) { showResult(partialMatches[0]); return; }
  if (partialMatches.length > 1) { showMultiple(partialMatches); return; }

  // ── NOT IN LOCAL DB — Ask Groq AI ──
  aiLookupOID(query);
}

function quickSearch(name) {
  document.getElementById('oid-input').value = name;
  search(name);
}

function browseCategory(cat) {
  document.getElementById('oid-input').value = cat;
  const matches = MIBS.filter(m => m.category === cat);
  if (matches.length === 1) { showResult(matches[0]); return; }
  showMultiple(matches);
}

// ─── SHOW RESULT ──────────────────────────────────────────────────────────────
function showResult(oid) {
  currentOID = oid;
  hide('empty-state'); hide('not-found'); hide('multi-result');
  show('result-section');

  document.getElementById('res-name').innerHTML = oid.name +
    (oid.aiIdentified ? ' <span class="badge-ai">🤖 AI Identified</span>' : '') +
    (oid.vendor && oid.vendor !== 'Standard' ? ` <span class="badge-vendor">${oid.vendor}</span>` : '');

  document.getElementById('res-oid').textContent = oid.oid;
  document.getElementById('res-mib').textContent = oid.mib;
  document.getElementById('res-type').textContent = oid.type;
  document.getElementById('res-status').textContent = oid.status;

  const catIcon = CATEGORY_ICONS[oid.category] || '📋';
  document.getElementById('res-category').textContent = catIcon + ' ' + oid.category;

  document.getElementById('res-rfc').textContent = oid.rfc;
  document.getElementById('res-desc').textContent = oid.desc;
  document.getElementById('res-tree').textContent = oid.tree;
  document.getElementById('res-example').textContent = oid.example;

  const accessEl = document.getElementById('res-access');
  accessEl.textContent = oid.access;
  accessEl.className = 'badge-access ' + (
    oid.access === 'read-only' ? 'access-ro' :
    oid.access === 'read-write' ? 'access-rw' : 'access-na'
  );

  const relatedEl = document.getElementById('res-related');
  relatedEl.innerHTML = '';
  if (oid.related && oid.related.length > 0) {
    oid.related.forEach(r => {
      const tag = document.createElement('span');
      tag.className = 'rel-tag';
      tag.textContent = r;
      tag.onclick = () => quickSearch(r);
      relatedEl.appendChild(tag);
    });
    show('related-section');
  } else {
    hide('related-section');
  }

  document.getElementById('ai-output').style.display = 'none';
  document.getElementById('ai-loading').style.display = 'none';
  document.getElementById('ai-btn').disabled = false;
  document.getElementById('ai-btn').textContent = 'Explain This OID';
}

function showMultiple(results) {
  currentOID = null;
  hide('empty-state'); hide('not-found'); hide('result-section');
  show('multi-result');
  const list = document.getElementById('multi-list');
  list.innerHTML = '';
  results.forEach(r => {
    const item = document.createElement('div');
    item.className = 'multi-item';
    item.innerHTML = `
      <div>
        <div class="multi-name">${r.name}</div>
        <div class="multi-oid">${r.oid}</div>
      </div>
      <span class="multi-mib">${r.mib}</span>`;
    item.onclick = () => showResult(r);
    list.appendChild(item);
  });
}

function showNotFound() {
  hide('empty-state'); hide('result-section'); hide('multi-result');
  show('not-found');
}

// ─── GROQ API HELPER ─────────────────────────────────────────────────────────
async function callGroq(messages, maxTokens = 600) {
  const response = await fetch('/api/groq', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      model: 'llama-3.3-70b-versatile',
      max_tokens: maxTokens,
      temperature: 0.1,
      messages
    })
  });
  if (!response.ok) {
    throw new Error(`HTTP ${response.status}`);
  }
  const data = await response.json();
  if (data.error) throw new Error(data.error.message || 'API error');
  return data.choices?.[0]?.message?.content || '';
}

function groqError(err, outputEl, btn) {
  hide('ai-loading');
  if (err.message?.includes('429')) {
    outputEl.textContent = '⚠️ Rate limit reached. Please wait a moment and try again.';
  } else if (err.message?.includes('403')) {
    outputEl.textContent = '⚠️ Access denied. Please try again later.';
  } else {
    outputEl.textContent = '⚠️ AI unavailable. Please check your connection and try again.';
  }
  show('ai-output');
  btn.textContent = 'Try Again';
  btn.disabled = false;
}

// ─── EXTRACT JSON SAFELY ──────────────────────────────────────────────────────
function extractJSON(raw) {
  if (!raw) return null;
  let cleaned = raw.replace(/```json\s*/gi, '').replace(/```\s*/g, '').trim();
  try { return JSON.parse(cleaned); } catch(e) {}
  const match = cleaned.match(/\{[\s\S]*\}/);
  if (match) {
    try { return JSON.parse(match[0]); } catch(e) {}
  }
  return null;
}

// ─── AI-POWERED DYNAMIC OID LOOKUP ───────────────────────────────────────────
async function aiLookupOID(query) {
  hide('empty-state'); hide('not-found'); hide('result-section'); hide('multi-result');

  document.getElementById('ai-loading-msg').textContent = '🔍 Searching AI knowledge base for this OID...';
  document.getElementById('ai-loading').style.display = 'flex';
  show('result-section');
  document.getElementById('oid-card').style.display = 'none';
  document.getElementById('ai-section').style.display = 'none';

  const systemPrompt = `You are a senior SNMP/MIB engineer with 20+ years experience. You have memorised thousands of OIDs from all major vendors.

CRITICAL RULES:
- You MUST respond with ONLY a raw JSON object. Nothing else. No explanation. No markdown. No text before or after.
- Start your response with { and end with }
- If the OID starts with 1.3.6.1.4.1.9 it is a CISCO enterprise OID - you MUST know Cisco MIBs
- If the OID starts with 1.3.6.1.4.1.2636 it is a JUNIPER OID
- If the OID starts with 1.3.6.1.4.1.6527 it is a NOKIA (Alcatel-Lucent) OID
- If the OID starts with 1.3.6.1.4.1.193 it is an ERICSSON OID
- Enterprise OIDs (1.3.6.1.4.1.*) are ALWAYS vendor-specific - make your best determination
- NEVER return found:false for a well-formed OID - always make your best determination
- For 1.3.6.1.4.1.9.2.1.8 the answer is: avgBusy1 in OLD-CISCO-CPU-MIB, Gauge32, read-only, 1-minute CPU busy percentage`;

  const userPrompt = `OID to look up: "${query}"

Respond with ONLY this JSON structure (fill in real values, no placeholders):
{"found":true,"oid":"${query}","name":"REAL_NAME","mib":"REAL_MIB_NAME","type":"REAL_TYPE","access":"read-only","status":"current","category":"REAL_CATEGORY","rfc":"Vendor Proprietary or RFC XXXX","tree":"iso.org.dod.internet.private.enterprises.VENDOR.path","desc":"REAL 2-3 sentence technical description of what this OID measures","example":"snmpget -v2c -c public <device_ip> ${query}","related":["relatedName1","relatedName2","relatedName3"],"vendor":"REAL_VENDOR_NAME"}

Replace ALL_CAPS placeholders with real values based on your SNMP knowledge.`;

  try {
    const raw = await callGroq([
      { role: 'system', content: systemPrompt },
      { role: 'user', content: userPrompt }
    ], 700);

    const parsed = extractJSON(raw);

    if (!parsed) {
      throw new Error(`JSON_PARSE_FAILED: ${raw.substring(0, 100)}`);
    }

    if (!parsed.found) {
      document.getElementById('ai-loading').style.display = 'none';
      document.getElementById('oid-card').style.display = '';
      document.getElementById('ai-section').style.display = '';
      showNotFound();
      return;
    }

    const aiResult = {
      oid: parsed.oid || query,
      name: parsed.name || query,
      mib: parsed.mib || 'Unknown MIB',
      type: parsed.type || 'Unknown',
      access: parsed.access || 'read-only',
      status: parsed.status || 'current',
      category: parsed.category || 'Vendor Specific',
      rfc: parsed.rfc || 'Vendor Proprietary',
      tree: parsed.tree || query,
      desc: parsed.desc || 'No description available.',
      example: parsed.example || `snmpget -v2c -c public <host> ${parsed.oid || query}`,
      related: Array.isArray(parsed.related) ? parsed.related : [],
      vendor: parsed.vendor || 'Unknown',
      aiIdentified: true
    };

    document.getElementById('ai-loading').style.display = 'none';
    document.getElementById('oid-card').style.display = '';
    document.getElementById('ai-section').style.display = '';
    showResult(aiResult);

    currentOID = aiResult;
    await getAIExplanation();

  } catch (err) {
    document.getElementById('ai-loading').style.display = 'none';
    document.getElementById('oid-card').style.display = '';
    document.getElementById('ai-section').style.display = '';

    show('result-section');
    const outputEl = document.getElementById('ai-output');
    if (err.message?.includes('429')) {
      outputEl.textContent = '⚠️ Rate limit reached. Please wait 30 seconds and try again.';
    } else if (err.message?.includes('JSON_PARSE_FAILED')) {
      outputEl.textContent = '⚠️ AI returned unexpected response. Please try again.';
    } else {
      outputEl.textContent = `⚠️ Lookup failed: ${err.message}. Please try again.`;
    }
    show('ai-output');
    show('ai-section');
  }
}

// ─── AI EXPLANATION ───────────────────────────────────────────────────────────
async function getAIExplanation() {
  if (!currentOID) return;
  const btn = document.getElementById('ai-btn');
  btn.disabled = true;
  btn.textContent = 'Explaining...';
  hide('ai-output');
  show('ai-loading');

  const vendorContext = currentOID.vendor && currentOID.vendor !== 'Standard'
    ? `This is a ${currentOID.vendor}-specific MIB object.`
    : 'This is a standard IETF MIB object.';

  const prompt = `You are an expert network engineer with deep knowledge of SNMP MIBs, vendor implementations, and telecom networks.

Explain this SNMP OID in plain English:

OID: ${currentOID.oid}
Name: ${currentOID.name}
MIB: ${currentOID.mib}
Type: ${currentOID.type}
Access: ${currentOID.access}
${vendorContext}
Description: ${currentOID.desc}

Provide a practical explanation covering:
1. What this OID measures or represents in simple terms
2. When and why a network engineer would query this OID
3. What typical values mean in a real network context
4. Any important caveats, vendor-specific behaviour, or gotchas
5. How it fits into network operations, monitoring, or troubleshooting

Keep it practical and concise — 150 to 200 words.`;

  try {
    const text = await callGroq([
      { role: 'system', content: 'You are an expert network engineer specialising in SNMP, MIBs, vendor implementations, and telecom network operations. Give practical, concise explanations.' },
      { role: 'user', content: prompt }
    ], 600);

    hide('ai-loading');
    const outputEl = document.getElementById('ai-output');
    outputEl.textContent = text;
    show('ai-output');
    btn.textContent = 'Regenerate';
    btn.disabled = false;

  } catch (err) {
    const outputEl = document.getElementById('ai-output');
    groqError(err, outputEl, btn);
  }
}

// ─── HELPERS ──────────────────────────────────────────────────────────────────
function show(id) { document.getElementById(id).style.display = ''; }
function hide(id) { document.getElementById(id).style.display = 'none'; }

// ─── EVENT LISTENERS ──────────────────────────────────────────────────────────
document.getElementById('search-btn').addEventListener('click', () => {
  search(document.getElementById('oid-input').value);
});
document.getElementById('oid-input').addEventListener('keydown', e => {
  if (e.key === 'Enter') search(document.getElementById('oid-input').value);
});

init();
</script>

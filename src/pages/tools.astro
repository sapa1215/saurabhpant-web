function getLayerStyle(n) {
	const s = { 7:{bg:"#E6F1FB",color:"#0C447C"}, 6:{bg:"#EAF3DE",color:"#27500A"}, 5:{bg:"#FAEEDA",color:"#633806"}, 4:{bg:"#EEEDFE",color:"#3C3489"}, 3:{bg:"#FAECE7",color:"#712B13"}, 2:{bg:"#E1F5EE",color:"#085041"}, 1:{bg:"#F1EFE8",color:"#444441"} };
	return s[n];
}

function renderStack(activeLayer) {
	const stack = document.getElementById("osi-stack");
	stack.innerHTML = "";
	LAYERS.forEach(layer => {
		const isActive = layer.num === activeLayer;
		const style = getLayerStyle(layer.num);
		const div = document.createElement("div");
		div.className = "stack-row";
		div.style.cssText = `border: ${isActive ? "2px" : "1px"} solid ${isActive ? style.color : "#eee"}; background:${isActive ? style.bg : "white"};`;
		div.innerHTML = `
			<span class="stack-num" style="background:${style.bg}; color:${style.color}; border:1px solid ${style.color};">${layer.num}</span>
			<span class="stack-text" style="font-weight:${isActive ? "bold" : "normal"}; color:${isActive ? style.color : "#666"};">Layer ${layer.num} — ${layer.name}</span>
			${isActive ? `<span class="stack-match" style="margin-left:auto; background:${style.bg}; color:${style.color}; border:1px solid ${style.color}; font-size:11px; padding:2px 8px; border-radius:20px;">match</span>` : ""}
		`;
		stack.appendChild(div);
	});
}

function showResult(result) {
	const resultArea = document.getElementById("result-area");
	const notFound = document.getElementById("not-found");
	if (!result) {
		resultArea.style.display = "none";
		notFound.style.display = "block";
		return;
	}
	notFound.style.display = "none";
	resultArea.style.display = "block";
	const layer = LAYERS.find(l => l.num === result.layer);
	const style = getLayerStyle(result.layer);
	const badge = document.getElementById("layer-badge");
	badge.style.background = style.bg;
	badge.style.color = style.color;
	badge.textContent = result.layer;
	document.getElementById("proto-name").textContent = result.name;
	document.getElementById("layer-name").textContent = `Layer ${layer.num} — ${layer.name} layer`;
	document.getElementById("layer-summary").textContent = layer.summary;
	document.getElementById("proto-desc").textContent = result.desc;
	const tags = document.getElementById("related-tags");
	tags.innerHTML = "";
	result.related.forEach(r => {
		const tag = document.createElement("button");
		tag.textContent = r;
		tag.onclick = () => quickSearch(r);
		tags.appendChild(tag);
	});
	renderStack(result.layer);
}

function lookup() {
	const input = document.getElementById("proto-input").value.trim().toLowerCase();
	if (!input) return;
	showResult(PROTOCOLS[input]);
}

function quickSearch(name) {
	document.getElementById("proto-input").value = name;
	showResult(PROTOCOLS[name.toLowerCase()]);
}

document.getElementById("proto-input").addEventListener("keydown", e => {
	if (e.key === "Enter") lookup();
});

document.getElementById("search-btn").addEventListener("click", () => {
	lookup();
});
</script>

---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---
<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Tools & Resources — ${SITE_TITLE}`}
			description="Curated tools, frameworks, and resources for telecom professionals working in OSS/BSS, 5G, MVNO, and digital infrastructure."
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="page-header">
				<h1>Tools & Resources</h1>
				<p class="subtitle">
					A curated collection of tools, frameworks, and resources I use and recommend 
					for telecom transformation, OSS/BSS modernization, and digital infrastructure.
				</p>
			</section>

			<!-- ========================================= -->
			<!-- INTERACTIVE TOOLS SECTION -->
			<!-- ========================================= -->
			<section class="tools-section">
				<h2>🛠️ Interactive Tools</h2>

				<!-- OSI LAYER EXPLORER -->
				<div class="embedded-tool">
					<div class="tool-intro">
						<h3>OSI Layer Explorer</h3>
						<p>Enter any protocol or network technology to instantly see which OSI layer it belongs to and a plain English explanation.</p>
					</div>

					<div class="tool-container">
						<div class="search-row">
							<input type="text" id="proto-input" placeholder="e.g. TCP, HTTP, Ethernet, BGP, TLS, GTP, SIP..." />
							<button id="search-btn">Search</button>
						</div>

						<div class="suggestions">
							<p class="suggestions-label">Try these</p>
							<div class="suggestion-tags">
								<button onclick="quickSearch('HTTP')">HTTP</button>
								<button onclick="quickSearch('TCP')">TCP</button>
								<button onclick="quickSearch('BGP')">BGP</button>
								<button onclick="quickSearch('Ethernet')">Ethernet</button>
								<button onclick="quickSearch('TLS')">TLS</button>
								<button onclick="quickSearch('DNS')">DNS</button>
								<button onclick="quickSearch('OSPF')">OSPF</button>
								<button onclick="quickSearch('5G NR')">5G NR</button>
								<button onclick="quickSearch('SIP')">SIP</button>
								<button onclick="quickSearch('MPLS')">MPLS</button>
								<button onclick="quickSearch('DIAMETER')">DIAMETER</button>
								<button onclick="quickSearch('GTP')">GTP</button>
								<button onclick="quickSearch('SCTP')">SCTP</button>
								<button onclick="quickSearch('LTE')">LTE</button>
							</div>
						</div>

						<div id="not-found" class="not-found" style="display:none;">
							<p class="not-found-title">Protocol not found</p>
							<p class="not-found-desc">Try common names like TCP, UDP, HTTP, DNS, OSPF, Ethernet, TLS, GTP, SIP</p>
						</div>

						<div id="result-area" style="display:none;">
							<div id="layer-card" class="layer-card">
								<div class="layer-card-header">
									<div id="layer-badge" class="layer-badge"></div>
									<div>
										<p id="proto-name" class="proto-name"></p>
										<p id="layer-name" class="layer-name"></p>
									</div>
								</div>
								<p id="layer-summary" class="layer-summary"></p>
								<p id="proto-desc" class="proto-desc"></p>
								<div class="related-box">
									<p class="related-label">Related protocols</p>
									<div id="related-tags" class="related-tags"></div>
								</div>
							</div>
							<div class="stack-section">
								<p class="stack-label">OSI stack — highlighted layer</p>
								<div id="osi-stack" class="osi-stack"></div>
							</div>
						</div>
					</div>
				</div>
			</section>
			<div class="tool-card">
    			<div class="tool-header">
        			<h3>Network Latency Calculator</h3>
        			<span class="tool-tag free">Free</span>
    			</div>
    			<p>Calculate and compare theoretical round-trip latency across fiber, 5G, 4G LTE, LEO and GEO satellite for any distance on Earth.</p>
    			<a href="/network-latency-calculator" class="tool-link">Try it →</a>
			</div>

			<!-- ========================================= -->
			<!-- OSS/BSS TOOLS -->
			<!-- ========================================= -->
			<section class="tools-section">
				<h2>⚙️ OSS/BSS & Network Management</h2>
				<div class="tools-grid">
					<div class="tool-card">
						<div class="tool-header">
							<h3>TM Forum Open APIs</h3>
							<span class="tool-tag free">Free</span>
						</div>
						<p>Industry-standard APIs for telecom BSS/OSS integration with over 1 million downloads as of 2025. Now includes AI Management, NaaS, and Open Gateway APIs in collaboration with GSMA CAMARA. Essential for any OSS/BSS modernization project.</p>
						<a href="https://www.tmforum.org/open-apis/" target="_blank" class="tool-link">Visit →</a>
					</div>
					<div class="tool-card">
						<div class="tool-header">
							<h3>3GPP Specifications</h3>
							<span class="tool-tag free">Free</span>
						</div>
						<p>Official 5G technical standards and specifications. The definitive reference for 5G network architecture and protocols.</p>
						<a href="https://www.3gpp.org/specifications" target="_blank" class="tool-link">Visit →</a>
					</div>
					<div class="tool-card">
						<div class="tool-header">
							<h3>GSMA Intelligence</h3>
							<span class="tool-tag free">Free</span>
						</div>
						<p>Global mobile industry data, forecasts, and research covering 5G growth, AI-driven telecom automation, NaaS, and network APIs. 2025 research focuses on standalone 5G, 5G-Advanced, and the path to 6G. Invaluable for market analysis and operator benchmarking.</p>
						<a href="https://www.gsma.com/solutions-and-impact/gsma-intelligence/" target="_blank" class="tool-link">Visit →</a>
					</div>
					<div class="tool-card">
						<div class="tool-header">
							<h3>ONAP</h3>
							<span class="tool-tag free">Free</span>
						</div>
						<p>Open Network Automation Platform — now on Paris release (R16). Evolved from monolithic orchestration to a modular ecosystem integrating GenAI, ML, and intent-based automation. Widely used for network lifecycle management in Tier-1 operator environments.</p>
						<a href="https://www.onap.org" target="_blank" class="tool-link">Visit →</a>
					</div>
					<div class="tool-card">
    					<div class="tool-header">
        					<h3>IEEE Communications Society</h3>
        					<span class="tool-tag free">Free</span>
    					</div>
   						 <p>Leading technical society for network and communications professionals. Publishes peer-reviewed research on OSS/BSS, 5G, network management, and emerging telecom technologies.</p>
   						 <a href="https://www.comsoc.org" target="_blank" class="tool-link">Visit →</a>
					</div>

					<div class="tool-card">
    					<div class="tool-header">
        					<h3>Mplify Alliance <span style="font-size:0.7rem; color:#888;">(formerly MEF)</span></h3>
        					<span class="tool-tag free">Free</span>
    					</div>
   						 <p>Global alliance formerly known as MEF Forum, rebranded in June 2025. Defines NaaS, LSO APIs for BSS/OSS automation, Carrier Ethernet standards, and SASE certification programs. Now focused on AI-powered network services.</p>
   						 <a href="https://www.mplify.net" target="_blank" class="tool-link">Visit →</a>
					</div>
				</div>
			</section>

			<!-- 5G & MVNO -->
			<section class="tools-section">
				<h2>📡 5G & MVNO Resources</h2>
				<div class="tools-grid">
					<div class="tool-card">
						<div class="tool-header">
							<h3>Open RAN Policy Coalition</h3>
							<span class="tool-tag free">Free</span>
						</div>
						<p>Key resource for Open RAN standards, policy developments, and ecosystem updates across global markets.</p>
						<a href="https://www.openranpolicy.org" target="_blank" class="tool-link">Visit →</a>
					</div>
					<div class="tool-card">
						<div class="tool-header">
							<h3>Light Reading</h3>
							<span class="tool-tag free">Free</span>
						</div>
						<p>Telecom industry news and analysis covering 5G, cloud, AI, and network transformation across global operators.</p>
						<a href="https://www.lightreading.com" target="_blank" class="tool-link">Visit →</a>
					</div>
					<div class="tool-card">
						<div class="tool-header">
							<h3>Telecoms.com</h3>
							<span class="tool-tag free">Free</span>
						</div>
						<p>Global telecom industry intelligence covering operator strategy, technology trends, and market analysis.</p>
						<a href="https://telecoms.com" target="_blank" class="tool-link">Visit →</a>
					</div>
				</div>
			</section>

			<!-- AI & AUTOMATION -->
			<section class="tools-section">
				<h2>🤖 AI & Automation in Telecom</h2>
				<div class="tools-grid">
					<div class="tool-card">
						<div class="tool-header">
							<h3>TM Forum AI & Analytics</h3>
							<span class="tool-tag free">Free</span>
						</div>
						<p>Frameworks and best practices for AI adoption in telecom operations, including autonomous networks guidance.</p>
						<a href="https://www.tmforum.org/topics/ai-analytics/" target="_blank" class="tool-link">Visit →</a>
					</div>
					<div class="tool-card">
						<div class="tool-header">
							<h3>ITU AI for 5G</h3>
							<span class="tool-tag free">Free</span>
						</div>
						<p>International Telecommunication Union resources on AI/ML applications for 5G networks and beyond.</p>
						<a href="https://www.itu.int/en/ITU-T/AI/Pages/default.aspx" target="_blank" class="tool-link">Visit →</a>
					</div>
				</div>
			</section>

			<!-- PRODUCTIVITY -->
			<section class="tools-section">
				<h2>🛠️ Professional Productivity</h2>
				<div class="tools-grid">
					<div class="tool-card">
						<div class="tool-header">
							<h3>Miro</h3>
							<span class="tool-tag freemium">Freemium</span>
						</div>
						<p>Online whiteboard for architecture diagrams, process mapping, and collaborative planning.</p>
						<a href="https://miro.com" target="_blank" class="tool-link">Visit →</a>
					</div>
					<div class="tool-card">
						<div class="tool-header">
							<h3>draw.io</h3>
							<span class="tool-tag free">Free</span>
						</div>
						<p>Free diagramming tool for network architecture, process flows, and system design. No account required.</p>
						<a href="https://draw.io" target="_blank" class="tool-link">Visit →</a>
					</div>
					<div class="tool-card">
						<div class="tool-header">
							<h3>Google Scholar</h3>
							<span class="tool-tag free">Free</span>
						</div>
						<p>Search engine for academic papers and industry research. Essential for staying current on telecom research.</p>
						<a href="https://scholar.google.com" target="_blank" class="tool-link">Visit →</a>
					</div>
				</div>
			</section>

			<!-- SUGGEST -->
			<section class="suggest-section">
				<h2>💡 Suggest a Tool</h2>
				<p>Know a tool that should be on this list? I'd love to hear about it.</p>
				<a href="/contact" class="suggest-btn">Get In Touch →</a>
			</section>

		</main>
		<Footer />
	</body>
</html>

<style>
	main { max-width: 900px; margin: 0 auto; padding: 2rem 1rem; }
	.page-header { text-align: center; padding: 2rem 0; border-bottom: 2px solid #eee; margin-bottom: 2rem; }
	.page-header h1 { font-size: 2.2rem; margin-bottom: 0.5rem; }
	.subtitle { color: #666; font-size: 1.1rem; max-width: 600px; margin: 0 auto; }
	.tools-section { margin-bottom: 3rem; }
	.tools-section h2 { font-size: 1.6rem; margin-bottom: 1.5rem; padding-bottom: 0.5rem; border-bottom: 1px solid #eee; }

	/* EMBEDDED TOOL */
	.embedded-tool { border: 1px solid #e0e0e0; border-radius: 12px; overflow: hidden; margin-bottom: 1rem; }
	.tool-intro { background: #f0f4ff; padding: 1.25rem 1.5rem; border-bottom: 1px solid #ddd; }
	.tool-intro h3 { margin: 0 0 0.4rem; font-size: 1.1rem; color: #2337ff; }
	.tool-intro p { margin: 0; color: #555; font-size: 0.9rem; }
	.tool-container { padding: 1.5rem; background: #fafafa; }
	.search-row { display: flex; gap: 8px; margin-bottom: 1.25rem; }
	.search-row input { flex: 1; padding: 0.7rem 1rem; border: 1px solid #ddd; border-radius: 8px; font-size: 14px; outline: none; }
	.search-row input:focus { border-color: #2337ff; }
	.search-row button { padding: 0.7rem 1.25rem; background: #2337ff; color: white; border: none; border-radius: 8px; font-size: 14px; font-weight: bold; cursor: pointer; }
	.search-row button:hover { background: #1a2acc; }
	.suggestions { margin-bottom: 1rem; }
	.suggestions-label { font-size: 12px; color: #888; margin: 0 0 6px; }
	.suggestion-tags { display: flex; flex-wrap: wrap; gap: 6px; }
	.suggestion-tags button { font-size: 12px; padding: 4px 10px; background: white; border: 1px solid #ddd; border-radius: 20px; cursor: pointer; color: #444; }
	.suggestion-tags button:hover { border-color: #2337ff; color: #2337ff; }
	.not-found { text-align: center; padding: 1.5rem; color: #888; }
	.not-found-title { font-weight: bold; margin: 0 0 6px; color: #555; }
	.not-found-desc { font-size: 13px; margin: 0; }
	.layer-card { background: white; border: 1px solid #e0e0e0; border-radius: 10px; padding: 1.25rem; margin-bottom: 1.25rem; }
	.layer-card-header { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; }
	.layer-badge { width: 48px; height: 48px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 22px; font-weight: bold; flex-shrink: 0; }
	.proto-name { font-size: 18px; font-weight: bold; margin: 0 0 3px; }
	.layer-name { font-size: 13px; color: #666; margin: 0; }
	.layer-summary { font-size: 13px; color: #666; margin: 0 0 10px; line-height: 1.7; font-style: italic; border-left: 3px solid #2337ff; padding-left: 10px; }
	.proto-desc { font-size: 14px; color: #333; margin: 0 0 12px; line-height: 1.7; }
	.related-box { padding-top: 10px; border-top: 1px solid #eee; }
	.related-label { font-size: 12px; color: #888; margin: 0 0 6px; }
	.related-tags { display: flex; flex-wrap: wrap; gap: 6px; }
	.related-tags button { font-size: 12px; padding: 3px 10px; background: #f0f4ff; border: 1px solid #c7d7ff; border-radius: 20px; cursor: pointer; color: #2337ff; }
	.related-tags button:hover { background: #2337ff; color: white; }
	.stack-section { margin-top: 0.75rem; }
	.stack-label { font-size: 12px; color: #888; margin: 0 0 8px; }
	.osi-stack { display: flex; flex-direction: column; gap: 5px; }
	.stack-row { display: flex; align-items: center; gap: 10px; padding: 8px 12px; border-radius: 8px; background: white; transition: all 0.2s; }
	.stack-num { width: 26px; height: 26px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: bold; flex-shrink: 0; }
	.stack-text { font-size: 13px; }
	.stack-match { margin-left: auto; font-size: 11px; padding: 2px 8px; border-radius: 20px; }

	/* RESOURCE CARDS */
	.tools-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem; }
	.tool-card { border: 1px solid #e0e0e0; border-radius: 8px; padding: 1.25rem; background: #fafafa; display: flex; flex-direction: column; gap: 0.6rem; }
	.tool-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 0.5rem; }
	.tool-header h3 { font-size: 1rem; margin: 0; }
	.tool-tag { padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.7rem; font-weight: bold; text-transform: uppercase; white-space: nowrap; }
	.tool-tag.free { background: #dcfce7; color: #166534; }
	.tool-tag.freemium { background: #fef3c7; color: #92400e; }
	.tool-card p { color: #555; font-size: 0.88rem; margin: 0; line-height: 1.6; flex: 1; }
	.tool-link { color: #2337ff; font-size: 0.88rem; font-weight: bold; text-decoration: none; }
	.tool-link:hover { text-decoration: underline; }
	.suggest-section { background: #f0f4ff; border-radius: 12px; padding: 2rem; text-align: center; }
	.suggest-section h2 { margin-bottom: 0.5rem; }
	.suggest-section p { color: #555; margin-bottom: 1rem; }
	.suggest-btn { background: #2337ff; color: white; padding: 0.75rem 1.5rem; border-radius: 6px; text-decoration: none; font-weight: bold; }
	@media (max-width: 600px) {
		.search-row { flex-direction: column; }
		.search-row button { width: 100%; }
	}
</style>

<script is:inline>
const LAYERS = [
	{ num: 7, name: "Application", color: "#185FA5", bg: "#E6F1FB", summary: "The layer humans interact with. It provides services directly to user applications — email, web browsing, file transfer. This is where software talks to the network." },
	{ num: 6, name: "Presentation", color: "#3B6D11", bg: "#EAF3DE", summary: "The translator. It converts data into a format the application can understand — handling encryption, compression, and encoding like JPEG or ASCII." },
	{ num: 5, name: "Session", color: "#854F0B", bg: "#FAEEDA", summary: "The conversation manager. It opens, maintains, and closes sessions between applications — making sure the right data goes to the right conversation." },
	{ num: 4, name: "Transport", color: "#533AB7", bg: "#EEEDFE", summary: "The delivery guarantee. It ensures data arrives completely and in order (TCP) or quickly without guarantees (UDP). Think of it as the postal service rules." },
	{ num: 3, name: "Network", color: "#993C1D", bg: "#FAECE7", summary: "The navigator. It figures out the best path to get data from source to destination across multiple networks — using IP addresses and routing." },
	{ num: 2, name: "Data Link", color: "#0F6E56", bg: "#E1F5EE", summary: "The local traffic cop. It manages how data moves between directly connected devices on the same network — using MAC addresses and error detection." },
	{ num: 1, name: "Physical", color: "#444441", bg: "#F1EFE8", summary: "The wire. It deals with actual bits transmitted as electrical signals, light pulses, or radio waves — cables, connectors, voltage levels." }
];

const PROTOCOLS = {
	"http": { layer: 7, name: "HTTP", desc: "HyperText Transfer Protocol — the foundation of the World Wide Web. Defines how web browsers request pages and servers respond.", related: ["HTTPS","FTP","SMTP","DNS"] },
	"https": { layer: 7, name: "HTTPS", desc: "HTTP Secure — HTTP encrypted with TLS. The standard for secure web communication. The padlock in your browser means HTTPS is active.", related: ["HTTP","TLS","SSL","DNS"] },
	"ftp": { layer: 7, name: "FTP", desc: "File Transfer Protocol — used to transfer files between client and server. Largely replaced by SFTP and HTTPS for security reasons.", related: ["SFTP","HTTP","TFTP"] },
	"smtp": { layer: 7, name: "SMTP", desc: "Simple Mail Transfer Protocol — the protocol that sends email between servers. When you hit send on an email, SMTP carries it to the recipient's mail server.", related: ["POP3","IMAP","HTTP"] },
	"dns": { layer: 7, name: "DNS", desc: "Domain Name System — translates human-readable domain names into IP addresses. Often called the phone book of the internet.", related: ["HTTP","DHCP","UDP"] },
	"pop3": { layer: 7, name: "POP3", desc: "Post Office Protocol v3 — downloads email from a server to a local device. Unlike IMAP, it typically removes mail from the server after download.", related: ["IMAP","SMTP","HTTP"] },
	"imap": { layer: 7, name: "IMAP", desc: "Internet Message Access Protocol — lets email clients access messages stored on a server. Emails stay on the server and sync across multiple devices.", related: ["POP3","SMTP","HTTP"] },
	"snmp": { layer: 7, name: "SNMP", desc: "Simple Network Management Protocol — used by network management systems to monitor and manage network devices. Essential in OSS/BSS stacks.", related: ["NETCONF","YANG","Syslog"] },
	"netconf": { layer: 7, name: "NETCONF", desc: "Network Configuration Protocol — a modern protocol for configuring and managing network devices. Widely used in telecom for automating OSS/BSS workflows.", related: ["YANG","RESTCONF","SNMP"] },
	"diameter": { layer: 7, name: "DIAMETER", desc: "The AAA protocol used in 4G/LTE and IMS core networks. DIAMETER replaced RADIUS for telecom-grade subscriber management and policy control.", related: ["RADIUS","SIP","GTP","IMS"] },
	"radius": { layer: 7, name: "RADIUS", desc: "Remote Authentication Dial-In User Service — authenticates and authorizes network access. Still widely used in broadband and enterprise networks.", related: ["DIAMETER","AAA","802.1X"] },
	"sip": { layer: 7, name: "SIP", desc: "Session Initiation Protocol — the standard for setting up, managing, and terminating voice and video calls over IP. The backbone of VoIP and IMS.", related: ["RTP","SDP","DIAMETER","IMS"] },
	"rtp": { layer: 7, name: "RTP", desc: "Real-time Transport Protocol — carries the actual audio and video data in a VoIP or video call. Works alongside SIP which handles call setup.", related: ["SIP","RTCP","UDP","SDP"] },
	"ldap": { layer: 7, name: "LDAP", desc: "Lightweight Directory Access Protocol — accesses and maintains directory services like user databases. Used in enterprise authentication and telecom subscriber management.", related: ["DIAMETER","RADIUS"] },
	"tls": { layer: 6, name: "TLS", desc: "Transport Layer Security — encrypts data between two communicating parties. The S in HTTPS comes from TLS.", related: ["SSL","HTTPS","X.509","PKI"] },
	"ssl": { layer: 6, name: "SSL", desc: "Secure Sockets Layer — the predecessor to TLS. Now deprecated but the term is still commonly used informally to refer to TLS encryption.", related: ["TLS","HTTPS","X.509"] },
	"jpeg": { layer: 6, name: "JPEG", desc: "A compression and encoding format for images. Defines how image data is encoded for transmission and decoded for display.", related: ["PNG","MPEG","ASCII"] },
	"mpeg": { layer: 6, name: "MPEG", desc: "Moving Picture Experts Group — standards for encoding audio and video. Defines how media is compressed for transmission and streaming.", related: ["JPEG","H.264","AAC"] },
	"netbios": { layer: 5, name: "NetBIOS", desc: "Network Basic Input/Output System — provides session layer services for applications on a local network.", related: ["SMB","NetBIOS over TCP/IP"] },
	"pptp": { layer: 5, name: "PPTP", desc: "Point-to-Point Tunneling Protocol — creates VPN tunnels and manages the session between VPN endpoints.", related: ["L2TP","IPSec","VPN"] },
	"tcp": { layer: 4, name: "TCP", desc: "Transmission Control Protocol — ensures reliable, ordered delivery of data via three-way handshake. Guarantees every packet arrives and retransmits lost data.", related: ["UDP","SCTP","IP","TLS"] },
	"udp": { layer: 4, name: "UDP", desc: "User Datagram Protocol — sends data fast without guarantees. Perfect for real-time applications like video calls and gaming where speed matters more than perfection.", related: ["TCP","SCTP","RTP","DNS"] },
	"sctp": { layer: 4, name: "SCTP", desc: "Stream Control Transmission Protocol — designed for telecom signaling, combining TCP reliability with UDP multi-streaming. Used in 4G/5G core networks.", related: ["TCP","UDP","M3UA","SS7"] },
	"quic": { layer: 4, name: "QUIC", desc: "Quick UDP Internet Connections — modern transport protocol built on UDP. Reduces connection setup time. The foundation of HTTP/3.", related: ["UDP","TCP","HTTP/3"] },
	"ip": { layer: 3, name: "IP", desc: "Internet Protocol — assigns addresses to devices and routes packets across networks. IPv4 uses 32-bit; IPv6 uses 128-bit addresses.", related: ["IPv4","IPv6","ICMP","BGP","OSPF"] },
	"ipv4": { layer: 3, name: "IPv4", desc: "Internet Protocol version 4 — dominant addressing system using 32-bit addresses. Address exhaustion drove the development of IPv6.", related: ["IPv6","NAT","DHCP","BGP"] },
	"ipv6": { layer: 3, name: "IPv6", desc: "Internet Protocol version 6 — 128-bit addresses providing virtually unlimited address space. Critical for 5G and IoT deployments.", related: ["IPv4","DHCPv6","BGP"] },
	"bgp": { layer: 3, name: "BGP", desc: "Border Gateway Protocol — the routing protocol that runs the internet. Exchanges routing information between autonomous systems globally.", related: ["OSPF","IS-IS","MPLS","IP"] },

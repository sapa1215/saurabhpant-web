---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---
<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Bandwidth Calculator — ${SITE_TITLE}`}
			description="Compare theoretical maximum bandwidth across wireless and wireline technologies — from 2G to fiber optic to LEO."
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="page-header">
				<h1>Bandwidth Calculator</h1>
				<p class="subtitle">
					Compare theoretical maximum bandwidth across wireless and wireline 
					technologies — from 2G to fiber optic to LEO.
				</p>
			</section>

			<div class="tool-container">

				<div class="top-row">
					<div class="select-group">
						<label>Technology A</label>
						<select id="ta"><option value="">— Select technology —</option></select>
					</div>
					<div class="vs-pill">VS</div>
					<div class="select-group">
						<label>Technology B</label>
						<select id="tb"><option value="">— Select technology —</option></select>
					</div>
					<button id="cmp-btn">Compare</button>
				</div>

				<div class="quick-row">
					<p class="quick-label">Quick comparisons</p>
					<div class="qtags">
						<span class="qtag" onclick="q('4g-lte','5g-sub6')">4G vs 5G</span>
						<span class="qtag" onclick="q('fiber-gpon','adsl2')">Fiber vs DSL</span>
						<span class="qtag" onclick="q('5g-mmwave','wifi6')">5G mmWave vs Wi-Fi 6</span>
						<span class="qtag" onclick="q('leo-sat','fiber-xgs')">LEO vs Fiber</span>
						<span class="qtag" onclick="q('2g-gprs','4g-lte')">2G vs 4G</span>
						<span class="qtag" onclick="q('cable-docsis','ethernet-10g')">Cable vs 10G LAN</span>
						<span class="qtag" onclick="q('wifi4','wifi6')">Wi-Fi 4 vs Wi-Fi 6</span>
					</div>
				</div>

				<div class="empty-state" id="empty">
					<p>⬆ Select two technologies and hit Compare</p>
				</div>

				<div class="result-wrap" id="result">

					<!-- HERO -->
					<div class="hero-vs" id="hero-vs"></div>

					<!-- SPEED RACE -->
					<div class="section-block">
						<div class="section-label">Speed race — solid = max, faded = typical</div>
						<div id="race-bars"></div>
					</div>

					<!-- REAL WORLD -->
					<div class="section-block">
						<div class="section-label">How long to download?</div>
						<div class="rw-grid" id="rw-grid"></div>
					</div>

					<!-- SPECS -->
					<div class="section-block">
						<div class="section-label">Technical specs</div>
						<table class="spec-table">
							<thead>
								<tr>
									<th>Spec</th>
									<th class="right" id="th-a">Tech A</th>
									<th class="right" id="th-b">Tech B</th>
								</tr>
							</thead>
							<tbody id="spec-body"></tbody>
						</table>
					</div>

					<!-- USE CASES -->
					<div class="section-block">
						<div class="section-label" style="margin-bottom:6px">What can you do with it?</div>
						<div class="uc-legend-row">
							<div class="uc-legend"><div class="dot dot-a"></div><span id="leg-a">Tech A</span></div>
							<div class="uc-legend"><div class="dot dot-b"></div><span id="leg-b">Tech B</span></div>
							<div class="uc-legend"><div class="dot dot-no"></div><span>Not supported</span></div>
						</div>
						<div class="uc-grid" id="uc-grid"></div>
					</div>

					<!-- FUN FACT -->
					<div class="fun-box" id="fun-box"></div>

				</div>

			</div>

			<section class="about-section">
				<h2>About This Calculator</h2>
				<p>
					Bandwidth figures are sourced from published 3GPP, IEEE 802.11, and ITU 
					specifications and represent theoretical maximums under optimal conditions. 
					Real-world speeds vary based on distance, interference, network load, and 
					device capability.
				</p>
				<p>
					This tool is designed to help students and professionals quickly understand 
					the relative capabilities of different network technologies — from the 
					earliest mobile standards to modern fiber and satellite systems.
				</p>
				<p class="tool-credit">
					Built by <a href="/about">Saurabh Pant</a> — 
					<a href="/contact">suggest improvements →</a>
				</p>
			</section>

		</main>
		<Footer />
	</body>
</html>

<style>
	main { max-width: 900px; margin: 0 auto; padding: 2rem 1rem; }
	.page-header { text-align: center; padding: 2rem 0; border-bottom: 2px solid #eee; margin-bottom: 2rem; }
	.page-header h1 { font-size: 2.2rem; margin-bottom: 0.5rem; }
	.subtitle { color: #666; font-size: 1.1rem; max-width: 600px; margin: 0 auto; }
	.tool-container { background: #fafafa; border: 1px solid #eee; border-radius: 16px; padding: 2rem; margin-bottom: 2rem; }

	/* TOP ROW */
	.top-row { display: flex; gap: 8px; align-items: flex-end; margin-bottom: 1.25rem; flex-wrap: wrap; }
	.select-group { flex: 1; min-width: 160px; }
	.select-group label { display: block; font-size: 12px; color: #666; margin-bottom: 4px; font-weight: bold; }
	.select-group select { width: 100%; padding: 0.7rem 1rem; border: 1px solid #ddd; border-radius: 8px; font-size: 14px; background: white; outline: none; }
	.select-group select:focus { border-color: #2337ff; }
	.vs-pill { padding: 6px 12px; background: #f0f0f0; border-radius: 20px; font-size: 12px; font-weight: bold; color: #888; align-self: flex-end; margin-bottom: 2px; flex: none; }
	#cmp-btn { padding: 0.7rem 1.5rem; background: #2337ff; color: white; border: none; border-radius: 8px; font-size: 14px; font-weight: bold; cursor: pointer; flex: none; align-self: flex-end; }
	#cmp-btn:hover { background: #1a2acc; }

	/* QUICK TAGS */
	.quick-row { margin-bottom: 1.5rem; }
	.quick-label { font-size: 11px; color: #888; margin: 0 0 6px; text-transform: uppercase; letter-spacing: 0.06em; }
	.qtags { display: flex; flex-wrap: wrap; gap: 5px; }
	.qtag { font-size: 11px; padding: 3px 10px; background: white; border: 1px solid #eee; border-radius: 20px; cursor: pointer; color: #666; }
	.qtag:hover { border-color: #2337ff; color: #2337ff; }

	/* EMPTY STATE */
	.empty-state { text-align: center; padding: 2.5rem; color: #888; font-size: 14px; }
	.empty-state p { margin: 0; }
	.result-wrap { display: none; }

	/* HERO */
	.hero-vs { display: grid; grid-template-columns: 1fr auto 1fr; gap: 8px; align-items: center; margin-bottom: 1.5rem; }
	.hero-card { border-radius: 12px; padding: 1.25rem; text-align: center; border: 1px solid #eee; background: white; }
	.hero-card.winner-card { border: 2px solid #0F6E56; background: #EAF3DE; }
	.hero-emoji { font-size: 2.5rem; margin-bottom: 6px; }
	.hero-name { font-size: 14px; font-weight: bold; color: #111; margin-bottom: 4px; }
	.hero-cat { font-size: 11px; padding: 2px 8px; border-radius: 10px; display: inline-block; margin-bottom: 8px; }
	.cat-wireless { background: #E6F1FB; color: #0C447C; }
	.cat-wireline { background: #EAF3DE; color: #27500A; }
	.hero-speed-a { font-size: 2rem; font-weight: bold; color: #185FA5; line-height: 1; margin-bottom: 2px; }
	.hero-speed-b { font-size: 2rem; font-weight: bold; color: #0F6E56; line-height: 1; margin-bottom: 2px; }
	.hero-unit { font-size: 11px; color: #888; }
	.hero-tag { font-size: 11px; margin-top: 6px; padding: 2px 8px; border-radius: 10px; display: inline-block; }
	.tag-winner { background: #EAF3DE; color: #27500A; }
	.tag-loser { background: #f0f0f0; color: #888; }
	.vs-circle { width: 44px; height: 44px; border-radius: 50%; background: #f0f0f0; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: bold; color: #888; flex-shrink: 0; margin: 0 auto; }

	/* SECTIONS */
	.section-block { margin-bottom: 1.5rem; }
	.section-label { font-size: 11px; color: #888; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 10px; font-weight: bold; }

	/* SPEED BARS */
	.race-row { margin-bottom: 10px; }
	.race-header { display: flex; justify-content: space-between; font-size: 12px; margin-bottom: 4px; }
	.race-label { color: #888; }
	.race-vals { display: flex; gap: 8px; }
	.race-val-a { color: #185FA5; font-weight: bold; }
	.race-val-b { color: #0F6E56; font-weight: bold; }
	.race-track { background: #eee; border-radius: 4px; height: 8px; overflow: hidden; margin-bottom: 3px; }
	.race-bar-a { height: 8px; background: #185FA5; border-radius: 4px; transition: width 0.6s ease; }
	.race-bar-b { height: 8px; background: #0F6E56; border-radius: 4px; transition: width 0.6s ease; }

	/* REAL WORLD */
	.rw-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 8px; }
	.rw-card { background: white; border: 1px solid #eee; border-radius: 10px; padding: 10px; text-align: center; }
	.rw-icon { font-size: 1.5rem; margin-bottom: 4px; }
	.rw-task { font-size: 11px; color: #888; margin-bottom: 6px; line-height: 1.3; }
	.rw-result-a { font-size: 13px; font-weight: bold; color: #185FA5; margin-bottom: 2px; }
	.rw-result-b { font-size: 13px; font-weight: bold; color: #0F6E56; }

	/* SPEC TABLE */
	.spec-table { width: 100%; border-collapse: collapse; }
	.spec-table th { font-size: 11px; color: #888; text-transform: uppercase; letter-spacing: 0.06em; padding: 6px 8px; text-align: left; border-bottom: 1px solid #eee; }
	.spec-table th.right { text-align: right; }
	.spec-table td { font-size: 13px; padding: 8px; border-bottom: 1px solid #f0f0f0; }
	.spec-table td.metric { color: #888; font-size: 12px; }
	.spec-table td.val-a { text-align: right; color: #185FA5; font-weight: bold; }
	.spec-table td.val-b { text-align: right; color: #0F6E56; font-weight: bold; }
	.spec-table td.muted { color: #aaa !important; font-weight: normal !important; }

	/* USE CASES */
	.uc-legend-row { display: flex; gap: 12px; margin-bottom: 8px; flex-wrap: wrap; }
	.uc-legend { display: flex; align-items: center; gap: 4px; font-size: 11px; color: #888; }
	.dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
	.dot-a { background: #185FA5; }
	.dot-b { background: #0F6E56; }
	.dot-no { background: #E24B4A; }
	.uc-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(100px, 1fr)); gap: 6px; }
	.uc-card { background: white; border: 1px solid #eee; border-radius: 8px; padding: 8px; text-align: center; }
	.uc-icon { font-size: 1.2rem; margin-bottom: 3px; }
	.uc-name { font-size: 10px; color: #888; margin-bottom: 5px; line-height: 1.3; }
	.uc-dot-row { display: flex; justify-content: center; gap: 4px; }

	/* FUN FACT */
	.fun-box { background: #f0f4ff; border-radius: 10px; padding: 12px 14px; font-size: 13px; color: #555; line-height: 1.6; border-left: 3px solid #2337ff; }
	.fun-box strong { color: #111; }

	/* ABOUT */
	.about-section { border-top: 2px solid #eee; padding-top: 2rem; }
	.about-section h2 { font-size: 1.4rem; margin-bottom: 1rem; }
	.about-section p { color: #555; line-height: 1.7; margin-bottom: 1rem; font-size: 0.95rem; }
	.tool-credit { color: #888 !important; font-size: 0.85rem !important; }
	.tool-credit a { color: #2337ff; }

	/* MOBILE */
	@media (max-width: 720px) {
		.top-row { flex-direction: column; }
		.select-group { min-width: 100%; }
		.vs-pill { display: none; }
		#cmp-btn { width: 100%; }
		.hero-vs { grid-template-columns: 1fr auto 1fr; }
		.hero-speed-a, .hero-speed-b { font-size: 1.4rem; }
		.hero-emoji { font-size: 1.8rem; }
		.rw-grid { grid-template-columns: 1fr 1fr; }
		.uc-grid { grid-template-columns: repeat(4, 1fr); }
	}
</style>

<script is:inline>
const T={
	'2g-gprs':{n:'2G GPRS',e:'📟',cat:'wireless',dl:0.114,ul:0.04,real:0.04,lat:500,freq:'900/1800 MHz',range:'35 km',mod:'GMSK',gen:'2G',fact:'2G is slower than a 1990s fax machine. Downloading a 4K movie would take roughly 3 weeks!'},
	'3g-hspa':{n:'3G HSPA+',e:'📱',cat:'wireless',dl:42,ul:5.76,real:5,lat:100,freq:'2100 MHz',range:'5 km',mod:'QPSK/16QAM',gen:'3G',fact:'3G felt like magic in 2005. It could stream a YouTube video — in 240p.'},
	'4g-lte':{n:'4G LTE',e:'📶',cat:'wireless',dl:150,ul:50,real:40,lat:30,freq:'700–2600 MHz',range:'2 km',mod:'64QAM/OFDMA',gen:'4G',fact:'4G LTE changed everything. HD streaming, video calls, apps — all became effortless on the go.'},
	'5g-sub6':{n:'5G Sub-6 GHz',e:'🚀',cat:'wireless',dl:1000,ul:200,real:200,lat:5,freq:'600 MHz – 6 GHz',range:'1 km',mod:'256QAM/OFDMA',gen:'5G',fact:'5G is so fast you can download a full HD movie before the download bar even appears on screen!'},
	'5g-mmwave':{n:'5G mmWave',e:'⚡',cat:'wireless',dl:10000,ul:2000,real:2000,lat:1,freq:'24–100 GHz',range:'100 m',mod:'256QAM/MIMO',gen:'5G',fact:'5G mmWave hits 10 Gbps — fast enough to download 1,000 songs per second! But a wall stops it dead.'},
	'wifi4':{n:'Wi-Fi 4 (802.11n)',e:'🏠',cat:'wireless',dl:600,ul:600,real:100,lat:5,freq:'2.4/5 GHz',range:'70 m',mod:'64QAM/MIMO',gen:'802.11n',fact:'Wi-Fi 4 from 2009 introduced MIMO — your router sprouted multiple antennas and home internet got faster.'},
	'wifi6':{n:'Wi-Fi 6 (802.11ax)',e:'🛜',cat:'wireless',dl:9608,ul:9608,real:1500,lat:2,freq:'2.4/5/6 GHz',range:'50 m',mod:'1024QAM/OFDMA',gen:'802.11ax',fact:'Wi-Fi 6 serves 8 devices simultaneously at full speed. Perfect for streaming on every screen at once!'},
	'leo-sat':{n:'LEO Satellite',e:'🛰️',cat:'wireless',dl:350,ul:40,real:150,lat:40,freq:'Ka/Ku-band',range:'Global',mod:'Adaptive QPSK',gen:'Space',fact:'LEO satellites orbit at 550 km. You can get broadband in the middle of the Pacific Ocean or the Sahara!'},
	'adsl2':{n:'ADSL2+',e:'☎️',cat:'wireline',dl:24,ul:1,real:8,lat:20,freq:'2.2 MHz',range:'5 km',mod:'DMT/QAM',gen:'xDSL',fact:'ADSL upload is painfully slow — sending a 1 GB file takes over 2 hours. Gets worse the farther you are!'},
	'vdsl2':{n:'VDSL2 / G.fast',e:'🔌',cat:'wireline',dl:300,ul:100,real:100,lat:10,freq:'35 MHz',range:'300 m',mod:'QAM-4096',gen:'xDSL',fact:'VDSL is fast — but only if you live close to the cabinet. Move 500m away and speed halves instantly.'},
	'cable-docsis':{n:'DOCSIS 3.1',e:'📺',cat:'wireline',dl:10000,ul:1000,real:800,lat:10,freq:'1.2 GHz',range:'Shared node',mod:'4096-QAM/OFDM',gen:'HFC Cable',fact:'Cable internet is shared with neighbours. Quiet at 3am = super fast. Peak time at 8pm = much slower!'},
	'fiber-gpon':{n:'GPON Fiber',e:'💎',cat:'wireline',dl:2500,ul:1250,real:1000,lat:2,freq:'1310/1490 nm',range:'20 km',mod:'NRZ Optical',gen:'GPON',fact:'Fiber sends light through glass — immune to interference, weather, and distance. The future of broadband!'},
	'fiber-xgs':{n:'XGS-PON Fiber',e:'🔵',cat:'wireline',dl:10000,ul:10000,real:2500,lat:1,freq:'1270/1577 nm',range:'20 km',mod:'NRZ Optical',gen:'XGS-PON',fact:'XGS-PON is the Ferrari of broadband — 10 Gbps both ways. Upload a 4K movie in 3 seconds flat!'},
	'ethernet-1g':{n:'Gigabit Ethernet',e:'🟢',cat:'wireline',dl:1000,ul:1000,real:940,lat:0.1,freq:'Cat5e/Cat6',range:'100 m',mod:'PAM-5',gen:'LAN',fact:'A Gigabit LAN cable is near-perfect — you get 940 Mbps of the 1000 Mbps theoretical. Near zero waste!'},
	'ethernet-10g':{n:'10G Ethernet',e:'🔷',cat:'wireline',dl:10000,ul:10000,real:9500,lat:0.05,freq:'Cat6a/SFP+',range:'100 m',mod:'PAM-16',gen:'LAN',fact:'10G Ethernet is the data center workhorse. Transferring your entire laptop drive takes under 90 seconds!'},
};

const UCS=[
	{n:'WhatsApp call',e:'📞',minMbps:0.1,maxLat:300},
	{n:'SD streaming',e:'📱',minMbps:3,maxLat:500},
	{n:'HD streaming',e:'🎬',minMbps:25,maxLat:200},
	{n:'4K streaming',e:'📺',minMbps:50,maxLat:100},
	{n:'Online gaming',e:'🎮',minMbps:10,maxLat:30},
	{n:'HD video call',e:'💻',minMbps:10,maxLat:150},
	{n:'Cloud backup',e:'☁️',minMbps:50,maxLat:1000},
	{n:'Remote desktop',e:'🖥️',minMbps:5,maxLat:50},
];

function fmt(mbps){
	if(mbps>=1000)return(mbps>=10000?Math.round(mbps/1000):(mbps/1000).toFixed(1))+' Gbps';
	if(mbps<1)return Math.round(mbps*1000)+' Kbps';
	return Math.round(mbps)+' Mbps';
}

function dlTime(mbps,gb){
	const secs=(gb*8*1024)/mbps;
	if(secs<1)return Math.round(secs*1000)+'ms';
	if(secs<60)return Math.round(secs)+'s';
	if(secs<3600)return Math.round(secs/60)+'min';
	return(secs/3600).toFixed(1)+'hr';
}

function populate(){
	const groups={wireless:'Wireless',wireline:'Wireline'};
	['ta','tb'].forEach(id=>{
		const sel=document.getElementById(id);
		Object.entries(groups).forEach(([cat,label])=>{
			const og=document.createElement('optgroup');
			og.label=label;
			Object.entries(T).filter(([,t])=>t.cat===cat).forEach(([key,t])=>{
				const o=document.createElement('option');
				o.value=key;o.textContent=t.n;
				og.appendChild(o);
			});
			sel.appendChild(og);
		});
	});
}

function q(a,b){
	document.getElementById('ta').value=a;
	document.getElementById('tb').value=b;
	go();
}

function go(){
	const ak=document.getElementById('ta').value;
	const bk=document.getElementById('tb').value;
	if(!ak||!bk||ak===bk){
		document.getElementById('empty').style.display='block';
		document.getElementById('result').style.display='none';
		return;
	}
	const A=T[ak],B=T[bk];
	document.getElementById('empty').style.display='none';
	document.getElementById('result').style.display='block';

	// HERO
	const aWins=A.dl>=B.dl;
	document.getElementById('hero-vs').innerHTML=`
		<div class="hero-card ${aWins?'winner-card':''}">
			<div class="hero-emoji">${A.e}</div>
			<div class="hero-name">${A.n}</div>
			<span class="hero-cat cat-${A.cat}">${A.cat}</span>
			<div class="hero-speed-a">${fmt(A.dl)}</div>
			<div class="hero-unit">peak downlink</div>
			<div class="hero-tag ${aWins?'tag-winner':'tag-loser'}">${aWins?'🏆 Faster':'Slower'}</div>
		</div>
		<div class="vs-circle">VS</div>
		<div class="hero-card ${!aWins?'winner-card':''}">
			<div class="hero-emoji">${B.e}</div>
			<div class="hero-name">${B.n}</div>
			<span class="hero-cat cat-${B.cat}">${B.cat}</span>
			<div class="hero-speed-b">${fmt(B.dl)}</div>
			<div class="hero-unit">peak downlink</div>
			<div class="hero-tag ${!aWins?'tag-winner':'tag-loser'}">${!aWins?'🏆 Faster':'Slower'}</div>
		</div>`;

	// BARS
	const gmax=Math.max(A.dl,B.dl,A.real,B.real,A.ul,B.ul);
	document.getElementById('race-bars').innerHTML=[
		{label:'Peak downlink',av:A.dl,bv:B.dl},
		{label:'Typical speed',av:A.real,bv:B.real},
		{label:'Peak uplink',av:A.ul,bv:B.ul},
	].map(r=>`
		<div class="race-row">
			<div class="race-header">
				<span class="race-label">${r.label}</span>
				<div class="race-vals">
					<span class="race-val-a">${fmt(r.av)}</span>
					<span style="color:#aaa">vs</span>
					<span class="race-val-b">${fmt(r.bv)}</span>
				</div>
			</div>
			<div class="race-track"><div class="race-bar-a" style="width:${Math.max(2,Math.round(r.av/gmax*100))}%"></div></div>
			<div class="race-track"><div class="race-bar-b" style="width:${Math.max(2,Math.round(r.bv/gmax*100))}%"></div></div>
		</div>`).join('');

	// REAL WORLD
	const rwtasks=[
		{e:'🎵',n:'1,000 songs (4GB)',gb:4},
		{e:'🎬',n:'HD movie (8GB)',gb:8},
		{e:'💾',n:'OS update (5GB)',gb:5},
		{e:'📸',n:'1,000 photos (3GB)',gb:3},
	];
	document.getElementById('rw-grid').innerHTML=rwtasks.map(t=>`
		<div class="rw-card">
			<div class="rw-icon">${t.e}</div>
			<div class="rw-task">${t.n}</div>
			<div class="rw-result-a">${A.e} ${dlTime(A.real,t.gb)}</div>
			<div class="rw-result-b">${B.e} ${dlTime(B.real,t.gb)}</div>
		</div>`).join('');

	// SPECS
	document.getElementById('th-a').textContent=A.n;
	document.getElementById('th-b').textContent=B.n;
	const specs=[
		{label:'Peak downlink',av:fmt(A.dl),bv:fmt(B.dl),an:A.dl,bn:B.dl,h:'better'},
		{label:'Typical speed',av:fmt(A.real),bv:fmt(B.real),an:A.real,bn:B.real,h:'better'},
		{label:'Latency',av:A.lat+'ms',bv:B.lat+'ms',an:A.lat,bn:B.lat,h:'lower'},
		{label:'Frequency',av:A.freq,bv:B.freq,an:null},
		{label:'Range',av:A.range,bv:B.range,an:null},
		{label:'Modulation',av:A.mod,bv:B.mod,an:null},
		{label:'Generation',av:A.gen,bv:B.gen,an:null},
	];
	document.getElementById('spec-body').innerHTML=specs.map(s=>{
		let ca='',cb='';
		if(s.an!==null){
			const aw=s.h==='better'?s.an>s.bn:s.an<s.bn;
			const bw=s.h==='better'?s.bn>s.an:s.bn<s.an;
			ca=aw?'':'muted';
			cb=bw?'':'muted';
		}
		return`<tr><td class="metric">${s.label}</td><td class="val-a ${ca}">${s.av}</td><td class="val-b ${cb}">${s.bv}</td></tr>`;
	}).join('');

	// USE CASES
	document.getElementById('leg-a').textContent=A.n;
	document.getElementById('leg-b').textContent=B.n;
	document.getElementById('uc-grid').innerHTML=UCS.map(uc=>{
		const aok=A.real>=uc.minMbps&&A.lat<=uc.maxLat;
		const bok=B.real>=uc.minMbps&&B.lat<=uc.maxLat;
		return`<div class="uc-card">
			<div class="uc-icon">${uc.e}</div>
			<div class="uc-name">${uc.n}</div>
			<div class="uc-dot-row">
				<div class="dot" style="background:${aok?'#185FA5':'#E24B4A'}"></div>
				<div class="dot" style="background:${bok?'#0F6E56':'#E24B4A'}"></div>
			</div>
		</div>`;
	}).join('');

	// FUN FACT
	const faster=A.dl>B.dl?A:B;
	const slower=A.dl>B.dl?B:A;
	const ratio=faster.dl/slower.dl;
	const ratioStr=ratio>=1000?Math.round(ratio/1000)+'K':ratio>=10?Math.round(ratio):ratio.toFixed(1);
	document.getElementById('fun-box').innerHTML=`<strong>Did you know?</strong> ${faster.n} is <strong>${ratioStr}x faster</strong> than ${slower.n} at peak. ${faster.fact}`;
}

document.getElementById('cmp-btn').addEventListener('click',go);
populate();
</script>

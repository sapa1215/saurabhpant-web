		desc: "320 MHz channels, 4096-QAM, 16×16 MIMO, and multi-link operation (MLO) across bands. Theoretical peak exceeds 46 Gbps — the fastest Wi-Fi standard.",
	},
	"leo": {
		name: "LEO Satellite",
		category: "Satellite",
		icon: "🛰️",
		dlMbps: 350,
		ulMbps: 40,
		typicalDlMbps: 100,
		typicalUlMbps: 15,
		band: "Ku / Ka band (12–30 GHz)",
		channelWidth: "250 MHz",
		modulation: "QPSK / 16-APSK",
		latencyMs: 20,
		rangeKm: 1000,
		desc: "Low Earth Orbit satellite (e.g., Starlink) at ~550 km altitude. Best-effort with variable throughput depending on demand. Suitable for rural broadband.",
	},
	"geo": {
		name: "GEO Satellite",
		category: "Satellite",
		icon: "🛰️",
		dlMbps: 100,
		ulMbps: 3,
		typicalDlMbps: 25,
		typicalUlMbps: 1,
		band: "Ku / Ka band (12–30 GHz)",
		channelWidth: "500 MHz",
		modulation: "DVB-S2X, 32-APSK",
		latencyMs: 600,
		rangeKm: 3000,
		desc: "Geostationary satellite at 35,786 km. Wide continental coverage but unavoidable 600ms+ latency. Limited to basic browsing and video streaming.",
	},
};

function fmtBw(mbps) {
	if (mbps >= 1000) {
		const g = mbps / 1000;
		return { num: g >= 10 ? g.toFixed(0) : g.toFixed(1), unit: "Gbps" };
	}
	if (mbps < 1) return { num: (mbps * 1000).toFixed(0), unit: "Kbps" };
	return { num: mbps >= 100 ? Math.round(mbps).toString() : mbps.toString(), unit: "Mbps" };
}

// Log scale 0–100% across 0.05 Mbps to 50,000 Mbps
function logPct(mbps) {
	const lo = Math.log10(0.05);
	const hi = Math.log10(50000);
	const pct = (Math.log10(Math.max(mbps, 0.05)) - lo) / (hi - lo) * 100;
	return Math.max(2, Math.min(100, pct));
}

function compare() {
	const keyA = document.getElementById("tech-a").value;
	const keyB = document.getElementById("tech-b").value;

	if (!keyA || !keyB) {
		alert("Please select both technologies!");
		return;
	}
	if (keyA === keyB) {
		alert("Please select two different technologies!");
		return;
	}

	const a = TECHNOLOGIES[keyA];
	const b = TECHNOLOGIES[keyB];

	// --- Summary cards ---
	const cards = document.getElementById("compare-cards");
	[{ t: a, cls: "card-a", letter: "A" }, { t: b, cls: "card-b", letter: "B" }].forEach(({ t, cls, letter }) => {
		const dl = fmtBw(t.dlMbps);
		const ul = fmtBw(t.ulMbps);
		cards.innerHTML += `
			<div class="compare-card ${cls}">
				<div class="card-label">Technology ${letter} — ${t.category} ${t.icon}</div>
				<div class="card-name">${t.name}</div>
				<div class="card-bw">
					<div class="bw-stat">
						<div class="bw-dir">↓ Downlink</div>
						<div class="bw-num">${dl.num}</div>
						<div class="bw-unit">${dl.unit}</div>
					</div>
					<div class="bw-stat">
						<div class="bw-dir">↑ Uplink</div>
						<div class="bw-num">${ul.num}</div>
						<div class="bw-unit">${ul.unit}</div>
					</div>
				</div>
			</div>
		`;
	});
	cards.innerHTML = cards.innerHTML; // re-trigger

	// --- Bar chart ---
	const barsGrid = document.getElementById("bars-grid");
	const rows = [
		{ label: "Peak DL", valA: a.dlMbps, valB: b.dlMbps },
		{ label: "Peak UL", valA: a.ulMbps, valB: b.ulMbps },
		{ label: "Typical DL", valA: a.typicalDlMbps, valB: b.typicalDlMbps },
		{ label: "Typical UL", valA: a.typicalUlMbps, valB: b.typicalUlMbps },
	];
	barsGrid.innerHTML = rows.map(row => {
		const fmtA = fmtBw(row.valA);
		const fmtB = fmtBw(row.valB);
		return `
			<div class="bar-group">
				<div class="bar-group-label">${row.label}</div>
				<div class="bar-row">
					<div class="bar-label" style="color:#2337ff">${a.name.split(" ")[0]}</div>
					<div class="bar-track"><div class="bar-fill fill-a" style="width:${logPct(row.valA)}%"></div></div>
					<div class="bar-value">${fmtA.num} ${fmtA.unit}</div>
				</div>
				<div class="bar-row">
					<div class="bar-label" style="color:#166534">${b.name.split(" ")[0]}</div>
					<div class="bar-track"><div class="bar-fill fill-b" style="width:${logPct(row.valB)}%"></div></div>
					<div class="bar-value">${fmtB.num} ${fmtB.unit}</div>
				</div>
			</div>
		`;
	}).join("");

	// --- Spec cards (side-by-side, each with label:value rows) ---
	const specDefs = [
		{ label: "Peak Downlink",    valA: fmtBw(a.dlMbps),         valB: fmtBw(b.dlMbps),         cmp: a.dlMbps > b.dlMbps ? "a" : "b" },
		{ label: "Peak Uplink",      valA: fmtBw(a.ulMbps),         valB: fmtBw(b.ulMbps),         cmp: a.ulMbps > b.ulMbps ? "a" : "b" },
		{ label: "Typical Downlink", valA: fmtBw(a.typicalDlMbps),  valB: fmtBw(b.typicalDlMbps),  cmp: a.typicalDlMbps > b.typicalDlMbps ? "a" : "b" },
		{ label: "Typical Uplink",   valA: fmtBw(a.typicalUlMbps),  valB: fmtBw(b.typicalUlMbps),  cmp: a.typicalUlMbps > b.typicalUlMbps ? "a" : "b" },
		{ label: "Latency",          valA: { num: a.latencyMs + " ms", unit: "" }, valB: { num: b.latencyMs + " ms", unit: "" }, cmp: a.latencyMs < b.latencyMs ? "a" : "b" },
		{ label: "Frequency",        valA: { num: a.band, unit: "" },        valB: { num: b.band, unit: "" },        cmp: null },
		{ label: "Channel Width",    valA: { num: a.channelWidth, unit: "" }, valB: { num: b.channelWidth, unit: "" }, cmp: null },
		{ label: "Modulation",       valA: { num: a.modulation, unit: "" },  valB: { num: b.modulation, unit: "" },  cmp: null },
		{ label: "Coverage",         valA: { num: a.rangeKm >= 1 ? a.rangeKm + " km" : (a.rangeKm * 1000) + " m", unit: "" }, valB: { num: b.rangeKm >= 1 ? b.rangeKm + " km" : (b.rangeKm * 1000) + " m", unit: "" }, cmp: null },
	];

	function valueClass(cmp, side) {
		if (cmp === null) return "is-neutral";
		return cmp === side ? "is-winner" : "is-loser";
	}

	function buildSpecCard(t, side, cardCls) {
		const rows = specDefs.map(s => {
			const raw = side === "a" ? s.valA : s.valB;
			const display = raw.num + (raw.unit ? " " + raw.unit : "");
			return `<div class="spec-row">
				<span class="spec-metric">${s.label}</span>
				<span class="spec-value ${valueClass(s.cmp, side)}">${display}</span>
			</div>`;
		}).join("");
		return `<div class="spec-card ${cardCls}">
			<div class="spec-card-header">
				<span class="spec-card-name">${t.name}</span>
				<span class="spec-badge">${t.category} ${t.icon}</span>
			</div>
			<div class="spec-card-body">${rows}</div>
		</div>`;
	}

	document.getElementById("specs-cards").innerHTML =
		buildSpecCard(a, "a", "spec-a") + buildSpecCard(b, "b", "spec-b");

	// --- Explanations ---
	const expGrid = document.getElementById("explanation-grid");
	expGrid.innerHTML = `
		<div class="explanation-card exp-a">
			<div class="exp-title">${a.icon} ${a.name}</div>
			<p class="exp-text">${a.desc}</p>
		</div>
		<div class="explanation-card exp-b">
			<div class="exp-title">${b.icon} ${b.name}</div>
			<p class="exp-text">${b.desc}</p>
		</div>
	`;

	document.getElementById("empty-state").style.display = "none";
	document.getElementById("results").style.display = "block";
}

document.getElementById("compare-btn").addEventListener("click", function() {
	document.getElementById("compare-cards").innerHTML = "";
	document.getElementById("bars-grid").innerHTML = "";
	document.getElementById("specs-cards").innerHTML = "";
	document.getElementById("explanation-grid").innerHTML = "";
	compare();
});
</script>

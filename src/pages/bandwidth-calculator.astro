---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---
<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Bandwidth Calculator — ${SITE_TITLE}`}
			description="Compare theoretical maximum bandwidth across wireless and wireline technologies — from 2G to fiber optic to LEO satellite. A free tool for telecom professionals."
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="page-header">
				<h1>Bandwidth Calculator</h1>
				<p class="subtitle">
					Compare theoretical maximum bandwidth across wireless and wireline
					technologies — from 2G to fiber optic to LEO.
				</p>
			</section>

			<div class="calculator-container">

				<!-- INPUT SECTION -->
				<div class="input-section">
					<div class="input-group">
						<label for="tech-a">Technology A</label>
						<select id="tech-a">
							<option value="">— Select technology —</option>
							<optgroup label="📱 Mobile">
								<option value="2g-edge">2G EDGE</option>
								<option value="3g-hspa">3G HSPA+</option>
								<option value="4g-lte">4G LTE</option>
								<option value="4g-lte-a">4G LTE-A</option>
								<option value="5g-sub6">5G Sub-6GHz</option>
								<option value="5g-mmwave">5G mmWave</option>
							</optgroup>
							<optgroup label="🏠 Fixed Line">
								<option value="adsl">ADSL2+</option>
								<option value="vdsl2">VDSL2 Vectored</option>
								<option value="gfast">G.fast</option>
								<option value="docsis31">DOCSIS 3.1 (Cable)</option>
								<option value="gpon">GPON Fiber</option>
								<option value="xgspon">XGS-PON Fiber</option>
							</optgroup>
							<optgroup label="📶 Wi-Fi">
								<option value="wifi4">Wi-Fi 4 (802.11n)</option>
								<option value="wifi5">Wi-Fi 5 (802.11ac)</option>
								<option value="wifi6">Wi-Fi 6 (802.11ax)</option>
								<option value="wifi7">Wi-Fi 7 (802.11be)</option>
							</optgroup>
							<optgroup label="🛰️ Satellite">
								<option value="leo">LEO Satellite (Starlink)</option>
								<option value="geo">GEO Satellite</option>
							</optgroup>
						</select>
					</div>

					<div class="vs-label">VS</div>

					<div class="input-group">
						<label for="tech-b">Technology B</label>
						<select id="tech-b">
							<option value="">— Select technology —</option>
							<optgroup label="📱 Mobile">
								<option value="2g-edge">2G EDGE</option>
								<option value="3g-hspa">3G HSPA+</option>
								<option value="4g-lte">4G LTE</option>
								<option value="4g-lte-a">4G LTE-A</option>
								<option value="5g-sub6">5G Sub-6GHz</option>
								<option value="5g-mmwave">5G mmWave</option>
							</optgroup>
							<optgroup label="🏠 Fixed Line">
								<option value="adsl">ADSL2+</option>
								<option value="vdsl2">VDSL2 Vectored</option>
								<option value="gfast">G.fast</option>
								<option value="docsis31">DOCSIS 3.1 (Cable)</option>
								<option value="gpon">GPON Fiber</option>
								<option value="xgspon">XGS-PON Fiber</option>
							</optgroup>
							<optgroup label="📶 Wi-Fi">
								<option value="wifi4">Wi-Fi 4 (802.11n)</option>
								<option value="wifi5">Wi-Fi 5 (802.11ac)</option>
								<option value="wifi6">Wi-Fi 6 (802.11ax)</option>
								<option value="wifi7">Wi-Fi 7 (802.11be)</option>
							</optgroup>
							<optgroup label="🛰️ Satellite">
								<option value="leo">LEO Satellite (Starlink)</option>
								<option value="geo">GEO Satellite</option>
							</optgroup>
						</select>
					</div>

					<button id="compare-btn">Compare</button>
				</div>

				<!-- EMPTY STATE -->
				<div id="empty-state" class="empty-state">
					<p>⬆️ Select two technologies above to compare bandwidth</p>
				</div>

				<!-- RESULTS SECTION -->
				<div id="results" style="display:none;">
					<h2 class="results-title">Bandwidth Comparison</h2>
					<p class="results-subtitle">Theoretical peak values under ideal conditions</p>

					<!-- Side-by-side summary cards -->
					<div id="compare-cards" class="compare-cards"></div>

					<!-- Bandwidth bar chart -->
					<div id="bars-section" class="bars-section">
						<h3 class="section-label">📊 Bandwidth at a Glance</h3>
						<div id="bars-grid" class="bars-grid"></div>
					</div>

					<!-- Specs comparison cards -->
					<div id="specs-section" class="specs-section">
						<h3 class="section-label">🔬 Technical Specifications</h3>
						<div id="specs-cards" class="spec-cards"></div>
					</div>

					<!-- Technology descriptions -->
					<div id="explanation-section" class="explanation-section">
						<h3 class="section-label">📡 About These Technologies</h3>
						<div id="explanation-grid" class="explanation-grid"></div>
					</div>
				</div>

			</div>

			<!-- ABOUT -->
			<section class="about-section">
				<h2>About This Calculator</h2>
				<p>
					Bandwidth figures are sourced from published 3GPP, IEEE 802.11, and ITU specifications
					and represent theoretical maximums under optimal conditions — full channel utilization,
					line-of-sight, best-case modulation, and no shared contention.
				</p>
				<p>
					Real-world throughput is typically 30–60% of theoretical peaks due to overhead,
					interference, distance attenuation, and network congestion. Use these numbers to
					understand the relative capability of each access technology, not as deployment targets.
				</p>
				<p class="tool-credit">
					Built by <a href="/about">Saurabh Pant</a> —
					<a href="/contact">suggest improvements →</a>
				</p>
			</section>

		</main>
		<Footer />
	</body>
</html>

<style>
	main { max-width: 900px; margin: 0 auto; padding: 2rem 1rem; }
	.page-header { text-align: center; padding: 2rem 0; border-bottom: 2px solid #eee; margin-bottom: 2rem; }
	.page-header h1 { font-size: 2.2rem; margin-bottom: 0.5rem; }
	.subtitle { color: #666; font-size: 1.1rem; max-width: 620px; margin: 0 auto; }

	/* Calculator container */
	.calculator-container { background: #fafafa; border: 1px solid #eee; border-radius: 16px; padding: 2rem; margin-bottom: 2rem; }

	/* Input section */
	.input-section { display: grid; grid-template-columns: 1fr auto 1fr auto; gap: 1rem; align-items: end; margin-bottom: 1.5rem; }
	.input-group { display: flex; flex-direction: column; gap: 0.4rem; }
	.input-group label { font-size: 0.85rem; font-weight: bold; color: #444; }
	.input-group select { padding: 0.7rem 1rem; border: 1px solid #ddd; border-radius: 8px; font-size: 14px; background: white; outline: none; }
	.input-group select:focus { border-color: #2337ff; }
	.vs-label { font-size: 1rem; font-weight: bold; color: #aaa; padding-bottom: 0.75rem; align-self: end; text-align: center; }
	#compare-btn { padding: 0.7rem 1.5rem; background: #2337ff; color: white; border: none; border-radius: 8px; font-size: 14px; font-weight: bold; cursor: pointer; white-space: nowrap; height: fit-content; }
	#compare-btn:hover { background: #1a2acc; }

	/* Empty state */
	.empty-state { text-align: center; padding: 3rem; color: #888; font-size: 1rem; }

	/* Results */
	.results-title { font-size: 1.4rem; margin-bottom: 0.25rem; }
	.results-subtitle { color: #888; font-size: 0.85rem; margin-bottom: 1.5rem; }

	/* Compare cards */
	.compare-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 2rem; }
	.compare-card { border-radius: 12px; padding: 1.5rem; border: 2px solid; text-align: center; }
	.compare-card.card-a { background: #eff6ff; border-color: #2337ff; }
	.compare-card.card-b { background: #f0fdf4; border-color: #166534; }
	.card-label { font-size: 0.7rem; font-weight: bold; text-transform: uppercase; margin-bottom: 0.35rem; }
	.card-a .card-label { color: #2337ff; }
	.card-b .card-label { color: #166534; }
	.card-name { font-size: 1.15rem; font-weight: bold; color: #111; margin-bottom: 0.2rem; }
	.card-category { font-size: 0.75rem; color: #777; margin-bottom: 1rem; }
	.card-bw { display: flex; justify-content: space-around; gap: 0.5rem; }
	.bw-stat { text-align: center; }
	.bw-dir { font-size: 0.65rem; color: #777; text-transform: uppercase; margin-bottom: 2px; }
	.bw-num { font-size: 1.6rem; font-weight: bold; line-height: 1.1; }
	.bw-unit { font-size: 0.7rem; color: #777; }
	.card-a .bw-num { color: #2337ff; }
	.card-b .bw-num { color: #166534; }
	.card-winner { display: inline-block; margin-top: 0.75rem; padding: 0.2rem 0.75rem; border-radius: 20px; font-size: 0.7rem; font-weight: bold; }
	.winner-dl { background: #fef3c7; color: #92400e; }
	.winner-ul { background: #dcfce7; color: #166534; }
	.winner-both { background: #dbeafe; color: #1d4ed8; }

	/* Bar chart */
	.bars-section { margin-bottom: 2rem; }
	.section-label { font-size: 1rem; margin-bottom: 1rem; color: #333; }
	.bars-grid { display: flex; flex-direction: column; gap: 0.75rem; }
	.bar-row { display: grid; grid-template-columns: 80px 1fr 90px; align-items: center; gap: 0.75rem; }
	.bar-label { font-size: 0.75rem; color: #555; font-weight: bold; text-align: right; }
	.bar-track { background: #eee; border-radius: 4px; height: 22px; position: relative; overflow: hidden; }
	.bar-fill { height: 100%; border-radius: 4px; transition: width 0.5s ease; min-width: 2px; }
	.bar-fill.fill-a { background: #2337ff; }
	.bar-fill.fill-b { background: #166534; }
	.bar-value { font-size: 0.78rem; font-weight: bold; color: #333; }

	/* Spec cards */
	.specs-section { margin-bottom: 2rem; }
	.spec-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
	.spec-card { background: white; border: 2px solid; border-radius: 12px; overflow: hidden; }
	.spec-card.spec-a { border-color: #2337ff; }
	.spec-card.spec-b { border-color: #166534; }
	.spec-card-header { padding: 0.85rem 1.1rem; display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; }
	.spec-card.spec-a .spec-card-header { background: #eff6ff; }
	.spec-card.spec-b .spec-card-header { background: #f0fdf4; }
	.spec-card-name { font-size: 0.95rem; font-weight: bold; color: #111; flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.spec-badge { display: inline-block; padding: 0.15rem 0.5rem; border-radius: 20px; font-size: 0.65rem; font-weight: bold; text-transform: uppercase; white-space: nowrap; flex-shrink: 0; }
	.spec-card.spec-a .spec-badge { background: #dbeafe; color: #1d4ed8; }
	.spec-card.spec-b .spec-badge { background: #dcfce7; color: #166534; }
	.spec-card-body { padding: 0.25rem 1.1rem 0.75rem; }
	.spec-row { display: flex; justify-content: space-between; align-items: baseline; gap: 0.5rem; padding: 0.4rem 0; border-bottom: 1px solid #f3f3f3; }
	.spec-row:last-child { border-bottom: none; }
	.spec-metric { font-size: 0.72rem; color: #888; white-space: nowrap; flex-shrink: 0; }
	.spec-value { font-size: 0.8rem; font-weight: 600; text-align: right; word-break: break-word; }
	.spec-value.is-winner { color: #166534; }
	.spec-value.is-loser { color: #bbb; }
	.spec-value.is-neutral { color: #333; }

	/* Explanations */
	.explanation-section { }
	.explanation-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
	.explanation-card { background: white; border: 1px solid #e0e0e0; border-radius: 8px; padding: 1.25rem; }
	.explanation-card.exp-a { border-left: 3px solid #2337ff; }
	.explanation-card.exp-b { border-left: 3px solid #166534; }
	.exp-title { font-size: 0.85rem; font-weight: bold; color: #333; margin-bottom: 0.4rem; }
	.exp-text { font-size: 0.8rem; color: #666; margin: 0; line-height: 1.6; }

	/* About */
	.about-section { border-top: 2px solid #eee; padding-top: 2rem; }
	.about-section h2 { font-size: 1.4rem; margin-bottom: 1rem; }
	.about-section p { color: #555; line-height: 1.7; margin-bottom: 1rem; font-size: 0.95rem; }
	.tool-credit { color: #888 !important; font-size: 0.85rem !important; }
	.tool-credit a { color: #2337ff; }

	/* Mobile */
	@media (max-width: 720px) {
		/* Stack dropdowns vertically, full width, VS hidden */
		.input-section { grid-template-columns: 1fr; gap: 0.75rem; }
		.vs-label { display: none; }
		.input-group select { width: 100%; }
		#compare-btn { width: 100%; }
		/* Result cards stack to single column */
		.compare-cards { grid-template-columns: 1fr; }
		.spec-cards { grid-template-columns: 1fr; }
		.explanation-grid { grid-template-columns: 1fr; }
		/* Tighten bar rows for narrow screens */
		.bar-row { grid-template-columns: 55px 1fr 72px; gap: 0.5rem; }
		.bar-label { font-size: 0.7rem; }
		.bar-value { font-size: 0.72rem; }
	}
</style>


---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---
<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Citations — ${SITE_TITLE}`}
			description="Academic citations, references, and research publications by Saurabh Pant on telecom, OSS/BSS, 5G, and digital infrastructure."
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="page-header">
				<h1>Citations & Research</h1>
				<p class="subtitle">
					Academic publications, citations, and research references from
					20+ years in telecom transformation and digital infrastructure.
				</p>
			</section>

			<!-- MY PUBLICATIONS -->
			<section class="cite-section">
				<h2>📄 My Published Articles & Papers</h2>

				<div class="pub-list">

					<div class="pub-card">
						<div class="pub-meta">
							<span class="status-badge published">Published</span>
							<span class="pub-venue">SSRN</span>
							<span class="pub-date">2026</span>
						</div>
						<h3><a href="/publications/trai-mvno-india-opportunity">Unlocking India's Billion-Dollar MVNO Opportunity: Why TRAI Must Lower the Entry Barrier Now</a></h3>
						<p class="pub-desc">An original policy analysis examining how TRAI reducing entry barriers for new MVNO operators could catalyse a new billion-dollar economy spanning IoT, rural connectivity, and niche digital services — with global licensing fee comparisons across UK, US, and EU.</p>
						<div class="pub-tags">
							<span class="tag">MVNO</span>
							<span class="tag">TRAI</span>
							<span class="tag">India</span>
							<span class="tag">IoT</span>
							<span class="tag">BSNL</span>
							<span class="tag">5G</span>
							<span class="tag">Telecom Policy</span>
							<span class="tag">Regulatory Reform</span>
						</div>
						<p class="cite-as-label">Cite as (APA)</p>
						<div class="cite-as-box">
							Pant, S. (2026). Unlocking India's Billion-Dollar MVNO Opportunity: Why TRAI Must Lower the Entry Barrier Now. <em>SSRN</em>. <a href="https://papers.ssrn.com/sol3/papers.cfm?abstract_id=6892441" target="_blank">https://papers.ssrn.com/sol3/papers.cfm?abstract_id=6892441</a>
						</div>
						<div class="card-links">
							<a href="/publications/trai-mvno-india-opportunity" class="card-link primary">Read Article →</a>
							<a href="https://papers.ssrn.com/sol3/papers.cfm?abstract_id=6892441" target="_blank" class="card-link secondary">View on SSRN →</a>
						</div>
					</div>

					<div class="pub-card">
						<div class="pub-meta">
							<span class="status-badge in-progress">In Progress</span>
							<span class="pub-venue">arXiv · IEEE</span>
						</div>
						<h3>Coming Soon</h3>
						<p class="pub-desc">Research on OSI layer networking — to be published on arXiv and IEEE.</p>
						<div class="pub-tags">
							<span class="tag">OSI</span>
							<span class="tag">Networking</span>
							<span class="tag">Research</span>
						</div>
					</div>

				</div>
			</section>

			<!-- METRICS -->
			<section class="metrics-section">
				<div class="metric"><h3>2</h3><p>Published Articles</p></div>
				<div class="metric"><h3>1</h3><p>In Progress</p></div>
				<div class="metric"><h3>20+</h3><p>Years Experience</p></div>
				<div class="metric"><h3>3</h3><p>Continents</p></div>
			</section>

			<!-- CITATIONS & REFERENCES -->
			<section class="cite-section">
				<h2>🔗 Citations & References</h2>

				<div class="placeholder-box">
					<div class="placeholder-icon">📬</div>
					<p class="placeholder-title">Citations will appear here once papers are published</p>
					<p class="placeholder-sub">
						In the meantime, you can find my academic profile on
						<a href="https://scholar.google.com/citations?user=QPDMorAAAAAJ&hl=en" target="_blank">Google Scholar →</a>
					</p>
				</div>
			</section>

			<!-- GOOGLE SCHOLAR CTA -->
			<section class="scholar-cta">
				<div class="cta-inner">
					<div>
						<h2>View Full Academic Profile</h2>
						<p>All publications, citations, and h-index metrics are tracked on Google Scholar.</p>
					</div>
					<a href="https://scholar.google.com/citations?user=QPDMorAAAAAJ&hl=en" target="_blank" class="cta-btn">
						<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 24a7 7 0 1 1 0-14 7 7 0 0 1 0 14zm0-24L0 9.5l4.838 3.94A8 8 0 0 1 12 9a8 8 0 0 1 7.162 4.44L24 9.5z"/></svg>
						Open Google Scholar
					</a>
				</div>
			</section>

		</main>
		<Footer />
	</body>
</html>

<style>
	main { max-width: 860px; margin: 0 auto; padding: 2rem 1rem; }
	.page-header { text-align: center; padding: 2rem 0; border-bottom: 2px solid #eee; margin-bottom: 2rem; }
	.page-header h1 { font-size: 2.2rem; margin-bottom: 0.5rem; }
	.subtitle { color: #666; font-size: 1.1rem; max-width: 600px; margin: 0 auto; }

	.cite-section { margin-bottom: 3rem; }
	.cite-section h2 { font-size: 1.6rem; margin-bottom: 1.5rem; padding-bottom: 0.5rem; border-bottom: 1px solid #eee; }

	/* Publication card */
	.pub-list { display: flex; flex-direction: column; gap: 1.5rem; }
	.pub-card { border: 1px solid #e0e0e0; border-radius: 8px; padding: 1.5rem; background: #fafafa; border-left: 4px solid #2337ff; }
	.pub-meta { display: flex; gap: 0.75rem; margin-bottom: 0.75rem; align-items: center; }
	.status-badge { padding: 0.2rem 0.6rem; border-radius: 4px; font-size: 0.75rem; font-weight: bold; text-transform: uppercase; }
	.status-badge.in-progress { background: #fef3c7; color: #92400e; }
	.status-badge.published { background: #dcfce7; color: #166534; }
	.status-badge.preprint { background: #dbeafe; color: #1d4ed8; }
	.pub-venue { color: #888; font-size: 0.85rem; }
	.pub-date { color: #888; font-size: 0.85rem; }
	.pub-card h3 a { color: #2337ff; text-decoration: none; }
	.pub-card h3 a:hover { text-decoration: underline; }
	.pub-card h3 { font-size: 1.1rem; margin-bottom: 0.5rem; color: #111; }
	.pub-desc { color: #555; font-size: 0.9rem; margin-bottom: 1rem; line-height: 1.6; }
	.pub-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; }
	.tag { background: #f0f4ff; color: #2337ff; padding: 0.2rem 0.6rem; border-radius: 20px; font-size: 0.75rem; }
	.cite-as-label { font-size: 0.7rem; font-weight: bold; color: #888; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.35rem; }
	.cite-as-box { background: #f8f9ff; border: 1px solid #e0e7ff; border-radius: 6px; padding: 0.75rem 1rem; margin-bottom: 1rem; font-size: 0.8rem; color: #444; line-height: 1.6; }
	.card-links { display: flex; gap: 0.5rem; flex-wrap: wrap; }
	.card-link { padding: 0.35rem 0.9rem; border-radius: 6px; font-size: 0.82rem; font-weight: 600; text-decoration: none; }
	.card-link.primary { background: #2337ff; color: white; }
	.card-link.primary:hover { background: #1a2acc; }
	.card-link.secondary { border: 1px solid #2337ff; color: #2337ff; }
	.card-link.secondary:hover { background: #f0f4ff; }

	/* Metrics */
	.metrics-section { display: flex; justify-content: space-around; flex-wrap: wrap; gap: 1rem; padding: 2rem; background: #f8fafc; border-radius: 12px; text-align: center; margin-bottom: 2rem; }
	.metric h3 { font-size: 2rem; color: #2337ff; margin: 0 0 0.25rem; }
	.metric p { color: #666; font-size: 0.85rem; margin: 0; }

	/* Placeholder */
	.placeholder-box { border: 2px dashed #ddd; border-radius: 8px; padding: 3rem 2rem; text-align: center; }
	.placeholder-icon { font-size: 2.5rem; margin-bottom: 1rem; }
	.placeholder-title { font-size: 1rem; color: #555; font-weight: 500; margin-bottom: 0.5rem; }
	.placeholder-sub { color: #888; font-size: 0.9rem; margin: 0; }
	.placeholder-sub a { color: #2337ff; text-decoration: none; }
	.placeholder-sub a:hover { text-decoration: underline; }

	/* Scholar CTA */
	.scholar-cta { background: #f0f4ff; border-radius: 12px; padding: 2rem; margin-top: 1rem; }
	.cta-inner { display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
	.scholar-cta h2 { font-size: 1.2rem; color: #111; margin-bottom: 0.35rem; }
	.scholar-cta p { color: #555; font-size: 0.9rem; margin: 0; }
	.cta-btn { display: flex; align-items: center; gap: 0.5rem; background: #2337ff; color: white; padding: 0.7rem 1.4rem; border-radius: 8px; text-decoration: none; font-size: 0.9rem; font-weight: 600; white-space: nowrap; transition: background 0.2s; }
	.cta-btn:hover { background: #1a2acc; }
</style>

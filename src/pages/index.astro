---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---
<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>Hi, I'm Saurabh Pant 👋</h1>
				<p class="tagline">
					Business Transformation & Deal-Oriented Strategy Leader<br/>
					<strong>Telecom | Digital Infra | Emerging Tech</strong>
				</p>
				<p class="location">📍 Denver Metropolitan Area, CO</p>
				<div class="cta-buttons">
					<a href="/blog" class="btn-primary">Read My Articles</a>
					<a href="/about" class="btn-secondary">About Me</a>
				</div>
			</section>

			<section class="summary">
				<h2>About Me</h2>
				<p>
					Telecom and digital infrastructure leader with <strong>20+ years of experience</strong> 
					designing, scaling, and optimizing OSS/BSS, MVNO, and 5G platforms for Tier-1 operators 
					across the <strong>US, UK, and APAC</strong>. My work spans strategy, architecture, 
					presales, and delivery — with a consistent focus on building scalable systems, 
					improving operational efficiency, and enabling high-growth business models.
				</p>
			</section>

			<section class="expertise">
				<h2>Areas of Expertise</h2>
				<div class="grid">
					<div class="card">
						<h3>🏗️ Architecture & Transformation</h3>
						<p>Designing end-to-end OSS/BSS, service assurance, inventory, and orchestration platforms for Tier-1 operators.</p>
					</div>
					<div class="card">
						<h3>📡 5G, MVNO & Digital Infra</h3>
						<p>Hands-on experience with Open RAN, NFV, SDN, and next-generation MVNO platforms across US, UK, and APAC.</p>
					</div>
					<div class="card">
						<h3>💼 Commercial & Strategic Impact</h3>
						<p>Supporting RFP/RFI cycles, evaluating COTS platforms, and shaping long-term IT roadmaps.</p>
					</div>
					<div class="card">
						<h3>🤖 AI-Enabled Operations</h3>
						<p>Applying GenAI and automation frameworks to modernize telecom processes and improve decision-making.</p>
					</div>
					<div class="card">
						<h3>📈 Value Creation</h3>
						<p>Reducing operational complexity, accelerating time-to-market, and enabling cost-efficient digital transformation.</p>
					</div>
					<div class="card">
						<h3>🌍 Global Experience</h3>
						<p>20+ years working with Tier-1 operators across the United States, United Kingdom, and Asia-Pacific.</p>
					</div>
				</div>
			</section>

			<section class="stats">
				<div class="stat">
					<h3>20+</h3>
					<p>Years Experience</p>
				</div>
				<div class="stat">
					<h3>Tier-1</h3>
					<p>Operators Served</p>
				</div>
				<div class="stat">
					<h3>3</h3>
					<p>Continents</p>
				</div>
				<div class="stat">
					<h3>5G</h3>
					<p>Next-Gen Platforms</p>
				</div>
			</section>

			<section class="connect">
				<h2>Let's Connect</h2>
				<p>I write regularly about telecom transformation, 5G strategy, and digital infrastructure trends.</p>
				<p>
					🐦 <a href="https://twitter.com/saurabh_pant">@saurabh_pant</a> &nbsp;|&nbsp;
					💼 <a href="https://www.linkedin.com/in/saurabh-pant-67b67a10/">LinkedIn</a> &nbsp;|&nbsp;
					📝 <a href="/blog">Articles</a>
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		max-width: 860px;
		margin: 0 auto;
		padding: 2rem 1rem;
	}
	.hero {
		text-align: center;
		padding: 3rem 0 2rem;
		border-bottom: 1px solid #eee;
		margin-bottom: 2rem;
	}
	.hero h1 {
		font-size: 2.5rem;
		margin-bottom: 1rem;
	}
	.tagline {
		font-size: 1.2rem;
		color: #555;
		margin-bottom: 0.5rem;
	}
	.location {
		color: #888;
		margin-bottom: 1.5rem;
	}
	.cta-buttons {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}
	.btn-primary {
		background: #2337ff;
		color: white;
		padding: 0.75rem 1.5rem;
		border-radius: 6px;
		text-decoration: none;
		font-weight: bold;
	}
	.btn-secondary {
		border: 2px solid #2337ff;
		color: #2337ff;
		padding: 0.75rem 1.5rem;
		border-radius: 6px;
		text-decoration: none;
		font-weight: bold;
	}
	.summary {
		margin-bottom: 2rem;
	}
	.expertise h2, .summary h2, .connect h2 {
		font-size: 1.8rem;
		margin-bottom: 1rem;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 1.5rem;
		margin-top: 1rem;
	}
	.card {
		border: 1px solid #eee;
		border-radius: 8px;
		padding: 1.5rem;
		background: #fafafa;
	}
	.card h3 {
		font-size: 1rem;
		margin-bottom: 0.5rem;
	}
	.card p {
		font-size: 0.9rem;
		color: #555;
		margin: 0;
	}
	.stats {
		display: flex;
		justify-content: space-around;
		flex-wrap: wrap;
		gap: 1rem;
		padding: 2rem 0;
		border-top: 1px solid #eee;
		border-bottom: 1px solid #eee;
		margin: 2rem 0;
		text-align: center;
	}
	.stat h3 {
		font-size: 2rem;
		color: #2337ff;
		margin: 0;
	}
	.stat p {
		color: #666;
		margin: 0;
	}
	.connect {
		text-align: center;
		padding: 2rem 0;
	}
	.connect a {
		color: #2337ff;
	}
</style>

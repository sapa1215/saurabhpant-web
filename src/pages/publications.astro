---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---
<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Publications & Citations — ${SITE_TITLE}`}
			description="Original research, policy analysis, and industry citations by Saurabh Pant — documenting 20+ years of telecom expertise."
		/>
	</head>
	<body>
		<Header />
		<main>

			<!-- SECTION 1: PAGE HEADER -->
			<section class="page-header">
				<h1>Publications & Citations</h1>
				<p class="subtitle">
					Original research, policy analysis, and industry citations — documenting 20+ years of telecom expertise.
				</p>
			</section>

			<!-- SECTION 2: MY PUBLICATIONS -->
			<section class="pub-section">
				<h2>📝 My Publications</h2>

				<div class="pub-list">

					<!-- MVNO / TRAI Policy Paper — featured -->
					<div class="pub-card pub-card-featured">
						<div class="pub-meta">
							<span class="pub-type policy">Policy Analysis</span>
							<span class="pub-status published">Published on SSRN</span>
							<span class="pub-date">June 2026</span>
						</div>
						<h3><a href="/publications/trai-mvno-india-opportunity">Unlocking India's Billion-Dollar MVNO Opportunity: Why TRAI Must Lower the Entry Barrier Now</a></h3>
						<p class="pub-desc">India's MVNO market remains one of the most underdeveloped among major economies. A bold regulatory reset by TRAI — reducing entry fees, streamlining licensing, and leveraging BSNL's underutilised infrastructure — could catalyse a new billion-dollar economy spanning IoT, rural connectivity, and niche digital services.</p>
						<div class="pub-tags">
							<span class="tag">MVNO</span>
							<span class="tag">TRAI</span>
							<span class="tag">India Telecom</span>
							<span class="tag">Regulatory Policy</span>
							<span class="tag">IoT</span>
							<span class="tag">BSNL</span>
						</div>
						<div class="pub-actions">
							<a href="/publications/trai-mvno-india-opportunity" class="card-link primary">Read Article →</a>
							<a href="https://papers.ssrn.com/sol3/papers.cfm?abstract_id=6892441" target="_blank" class="card-link ssrn">View on SSRN →</a>
						</div>
					</div>

				</div>
			</section>

			<!-- SECTION 3: CITATIONS & RECOGNITION -->
			<section class="pub-section">
				<h2>📄 Citations & Recognition</h2>

				<!-- Metrics -->
				<div class="metrics-section">
					<div class="metric"><h3>2</h3><p>Published Articles</p></div>
					<div class="metric"><h3>1</h3><p>In Progress</p></div>
					<div class="metric"><h3>20+</h3><p>Years Experience</p></div>
					<div class="metric"><h3>3</h3><p>Continents</p></div>
				</div>

				<!-- Google Scholar CTA -->
				<div class="scholar-cta">
					<div class="cta-inner">
						<div>
							<h2>Track Citations on Google Scholar</h2>
							<p>Track citations and follow my research on Google Scholar — where all citation metrics, h-index, and academic impact are recorded.</p>
						</div>
						<a href="https://scholar.google.com/citations?user=QPDMorAAAAAJ&hl=en" target="_blank" class="cta-btn">
							<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 24a7 7 0 1 1 0-14 7 7 0 0 1 0 14zm0-24L0 9.5l4.838 3.94A8 8 0 0 1 12 9a8 8 0 0 1 7.162 4.44L24 9.5z"/></svg>
							Open Google Scholar
						</a>
					</div>
				</div>

			</section>

			<!-- SECTION 4: ACADEMIC PROFILES -->
			<section class="pub-section">
				<h2>🎓 Academic Profiles</h2>

				<div class="profiles-grid">
					<a href="https://scholar.google.com/citations?user=QPDMorAAAAAJ&hl=en" target="_blank" class="profile-card">
						<div class="profile-icon">
							<svg viewBox="0 0 24 24" width="26" height="26" fill="#2337ff"><path d="M12 24a7 7 0 1 1 0-14 7 7 0 0 1 0 14zm0-24L0 9.5l4.838 3.94A8 8 0 0 1 12 9a8 8 0 0 1 7.162 4.44L24 9.5z"/></svg>
						</div>
						<div class="profile-info">
							<h3>Google Scholar</h3>
							<p>Citation metrics, h-index, and full academic publication record</p>
						</div>
						<span class="profile-arrow">→</span>
					</a>

					<a href="https://papers.ssrn.com/sol3/papers.cfm?abstract_id=6892441" target="_blank" class="profile-card">
						<div class="profile-icon profile-icon-text">SSRN</div>
						<div class="profile-info">
							<h3>SSRN</h3>
							<p>Published working papers and policy analysis — Abstract #6892441</p>
						</div>
						<span class="profile-arrow">→</span>
					</a>

					<a href="https://www.linkedin.com/in/saurabh-pant-67b67a10/" target="_blank" class="profile-card">
						<div class="profile-icon">
							<svg viewBox="0 0 16 16" width="26" height="26" fill="#0077b5"><path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.248V6.169H2.542v7.225h2.401zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016a5.54 5.54 0 0 1 .016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4z"/></svg>
						</div>
						<div class="profile-info">
							<h3>LinkedIn</h3>
							<p>Professional profile, publications, and thought leadership posts</p>
						</div>
						<span class="profile-arrow">→</span>
					</a>
				</div>

				<!-- Google Scholar CTA -->
				<div class="scholar-cta">
					<div class="cta-inner">
						<div>
							<h2>View Full Academic Profile</h2>
							<p>All publications, citations, and h-index metrics are tracked on Google Scholar.</p>
						</div>
						<a href="https://scholar.google.com/citations?user=QPDMorAAAAAJ&hl=en" target="_blank" class="cta-btn">
							<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 24a7 7 0 1 1 0-14 7 7 0 0 1 0 14zm0-24L0 9.5l4.838 3.94A8 8 0 0 1 12 9a8 8 0 0 1 7.162 4.44L24 9.5z"/></svg>
							Open Google Scholar
						</a>
					</div>
				</div>

			</section>

		</main>
		<Footer />
	</body>
</html>

<style>
	main { max-width: 860px; margin: 0 auto; padding: 2rem 1rem; }

	/* Page header */
	.page-header { text-align: center; padding: 2rem 0; border-bottom: 2px solid #eee; margin-bottom: 2rem; }
	.page-header h1 { font-size: 2.2rem; margin-bottom: 0.5rem; }
	.subtitle { color: #666; font-size: 1.1rem; max-width: 600px; margin: 0 auto; }

	/* Sections */
	.pub-section { margin-bottom: 3.5rem; }
	.pub-section > h2 { font-size: 1.6rem; margin-bottom: 1.5rem; padding-bottom: 0.5rem; border-bottom: 1px solid #eee; }

	/* Card list */
	.pub-list { display: flex; flex-direction: column; gap: 1.5rem; margin-bottom: 2rem; }
	.pub-card { border: 1px solid #e0e0e0; border-radius: 8px; padding: 1.5rem; background: #fafafa; border-left: 4px solid #2337ff; }
	.pub-card-featured { border-left-color: #166534; background: #f0fdf4; }

	/* Meta row */
	.pub-meta { display: flex; gap: 0.75rem; margin-bottom: 0.75rem; align-items: center; flex-wrap: wrap; }
	.pub-venue { color: #888; font-size: 0.85rem; }
	.pub-date { color: #888; font-size: 0.85rem; }

	/* Type badges */
	.pub-type { padding: 0.2rem 0.6rem; border-radius: 4px; font-size: 0.75rem; font-weight: bold; text-transform: uppercase; }
	.pub-type.article { background: #dbeafe; color: #1d4ed8; }
	.pub-type.policy { background: #fae8ff; color: #7e22ce; }
	.pub-type.paper { background: #dcfce7; color: #166534; }

	/* Status badges */
	.pub-status, .status-badge { padding: 0.2rem 0.6rem; border-radius: 4px; font-size: 0.75rem; font-weight: bold; text-transform: uppercase; }
	.pub-status.published, .status-badge.published { background: #dcfce7; color: #166534; }
	.status-badge.in-progress { background: #fef3c7; color: #92400e; }

	/* Card body */
	.pub-card h3 { font-size: 1.1rem !important; margin-bottom: 0.5rem; color: #111; }
	.pub-card h3 a { color: #2337ff !important; text-decoration: none !important; }
	.pub-card h3 a:hover { text-decoration: underline !important; }
	.pub-desc { color: #555; font-size: 0.9rem; margin-bottom: 1rem; line-height: 1.6; }
	.pub-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; }
	.tag { background: #f0f4ff; color: #2337ff; padding: 0.2rem 0.6rem; border-radius: 20px; font-size: 0.75rem; }

	/* Action buttons */
	.pub-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.25rem; }
	.card-link { padding: 0.35rem 0.9rem; border-radius: 6px; font-size: 0.82rem; font-weight: 600; text-decoration: none; }
	.card-link.primary { background: #2337ff; color: white; }
	.card-link.primary:hover { background: #1a2acc; }
	.card-link.secondary { border: 1px solid #2337ff; color: #2337ff; }
	.card-link.secondary:hover { background: #f0f4ff; }
	.card-link.ssrn { background: #166534; color: white; }
	.card-link.ssrn:hover { background: #14532d; }

	/* APA citation box */
	.cite-as-label { font-size: 0.7rem; font-weight: bold; color: #888; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.35rem; }
	.cite-as-box { background: #f8f9ff; border: 1px solid #e0e7ff; border-radius: 6px; padding: 0.75rem 1rem; margin-bottom: 1rem; font-size: 0.8rem; color: #444; line-height: 1.6; }
	.cite-as-box a { color: #2337ff; word-break: break-all; }

	/* Metrics */
	.metrics-section { display: flex; justify-content: space-around; flex-wrap: wrap; gap: 1rem; padding: 2rem; background: #f8fafc; border-radius: 12px; text-align: center; margin-bottom: 1.5rem; }
	.metric h3 { font-size: 2rem; color: #2337ff; margin: 0 0 0.25rem; }
	.metric p { color: #666; font-size: 0.85rem; margin: 0; }

	/* Citation entry box */
	.cite-entry-box { border: 1px solid #e0e7ff; border-radius: 8px; padding: 1.5rem; background: #f8f9ff; }
	.cite-entry-label { font-size: 0.7rem; font-weight: bold; color: #888; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem; }
	.cite-note { color: #888; font-size: 0.88rem; margin: 0.75rem 0 0; }
	.cite-note a { color: #2337ff; text-decoration: none; }
	.cite-note a:hover { text-decoration: underline; }

	/* Academic profiles */
	.profiles-grid { display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2rem; }
	.profile-card { display: flex; align-items: center; gap: 1.25rem; padding: 1.25rem 1.5rem; border: 1px solid #e0e0e0; border-radius: 10px; background: #fafafa; text-decoration: none; transition: border-color 0.2s, transform 0.2s; }
	.profile-card:hover { border-color: #2337ff; transform: translateY(-2px); }
	.profile-icon { flex-shrink: 0; display: flex; align-items: center; }
	.profile-icon-text { font-size: 0.8rem; font-weight: 900; color: #1c4a2e; background: #dcfce7; padding: 0.4rem 0.55rem; border-radius: 6px; letter-spacing: 0.05em; }
	.profile-info { flex: 1; }
	.profile-info h3 { font-size: 1rem; font-weight: 600; color: #111; margin: 0 0 0.2rem; }
	.profile-info p { font-size: 0.85rem; color: #888; margin: 0; }
	.profile-arrow { color: #2337ff; font-size: 1.1rem; font-weight: bold; flex-shrink: 0; }

	/* Scholar CTA */
	.scholar-cta { background: #f0f4ff; border-radius: 12px; padding: 2rem; }
	.cta-inner { display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
	.scholar-cta h2 { font-size: 1.2rem; color: #111; margin-bottom: 0.35rem; }
	.scholar-cta p { color: #555; font-size: 0.9rem; margin: 0; }
	.cta-btn { display: flex; align-items: center; gap: 0.5rem; background: #2337ff; color: white; padding: 0.7rem 1.4rem; border-radius: 8px; text-decoration: none; font-size: 0.9rem; font-weight: 600; white-space: nowrap; }
	.cta-btn:hover { background: #1a2acc; }

	/* Mobile */
	@media (max-width: 720px) {
		.page-header h1 { font-size: 1.7rem; }
		.metrics-section { padding: 1.25rem; }
		.cta-inner { flex-direction: column; align-items: flex-start; }
		.profile-card { padding: 1rem; }
	}
</style>

---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---
<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<button class="hamburger" id="hamburger" aria-label="Open menu">
			<span></span>
			<span></span>
			<span></span>
		</button>
		<div class="internal-links" id="nav-menu">
			<button class="close-btn" id="close-menu" aria-label="Close menu">✕</button>
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Articles</HeaderLink>
			<HeaderLink href="/publications">Publications</HeaderLink>
			<HeaderLink href="/citations">Citations</HeaderLink>
			<HeaderLink href="/tools">Tools</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/contact">Contact</HeaderLink>
		</div>
		<div class="overlay" id="overlay"></div>
		<div class="social-links">
			<a href="https://www.linkedin.com/in/saurabh-pant-67b67a10/" target="_blank">
				<span class="sr-only">Connect with Saurabh Pant on LinkedIn</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32">
					<path fill="currentColor" d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.248V6.169H2.542v7.225h2.401zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016a5.54 5.54 0 0 1 .016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4z"/>
				</svg>
			</a>
			<a href="https://x.com/saurabh_pant" target="_blank">
				<span class="sr-only">Follow Saurabh Pant on X</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32">
					<path fill="currentColor" d="M12.6.75h2.454l-5.36 6.142L16 15.25h-4.937l-3.867-5.07-4.425 5.07H.316l5.733-6.57L0 .75h5.063l3.495 4.633L12.601.75Zm-.86 13.028h1.36L4.323 2.145H2.865z"/>
				</svg>
			</a>
			<a href="https://saurabhpant.substack.com" target="_blank">
    			<span class="sr-only">Subscribe to Saurabh Pant on Substack</span>
    			<svg viewBox="0 0 24 24" aria-hidden="true" width="32" height="32">
        <path fill="currentColor" d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"/>
    </svg>
</a>
			<a href="https://scholar.google.com/citations?user=QPDMorAAAAAJ&hl=en" target="_blank">
				<span class="sr-only">View Saurabh Pant on Google Scholar</span>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="32" height="32">
					<path fill="currentColor" d="M12 24a7 7 0 1 1 0-14 7 7 0 0 1 0 14zm0-24L0 9.5l4.838 3.94A8 8 0 0 1 12 9a8 8 0 0 1 7.162 4.44L24 9.5z"/>
				</svg>
			</a>
		</div>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
		position: relative;
		z-index: 200;
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}
	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 60px;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.internal-links {
		display: flex;
		align-items: center;
	}
	.social-links,
	.social-links a {
		display: flex;
	}

	/* HAMBURGER BUTTON */
	.hamburger {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		background: none;
		border: none;
		cursor: pointer;
		padding: 8px;
		position: relative;
		z-index: 200;
		flex-shrink: 0;
	}
	.hamburger span {
		display: block;
		width: 24px;
		height: 2px;
		background: rgb(var(--black));
		border-radius: 2px;
		transition: all 0.3s;
	}
	/* Animate bars → X when menu is open */
	.hamburger.menu-open span:nth-child(1) {
		transform: rotate(45deg) translate(5px, 5px);
	}
	.hamburger.menu-open span:nth-child(2) {
		opacity: 0;
		transform: scaleX(0);
	}
	.hamburger.menu-open span:nth-child(3) {
		transform: rotate(-45deg) translate(5px, -5px);
	}

	/* CLOSE BUTTON */
	.close-btn {
		display: none;
		background: none;
		border: none;
		font-size: 1.5rem;
		cursor: pointer;
		padding: 1rem 1.5rem;
		color: rgb(var(--black));
		text-align: right;
		width: 100%;
	}

	/* OVERLAY */
	.overlay {
		display: none;
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: rgba(0,0,0,0.3);
		z-index: 149;
	}

	@media (max-width: 720px) {
		header {
			padding: 0 1rem;
		}
		nav {
			height: 52px;
			display: flex;
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
		}
		h2 {
			flex: 1;
			line-height: 1;
		}
		h2 a {
			padding: 0;
			border-bottom: none;
		}
		.hamburger {
			display: flex;
			margin-left: auto;
		}
		.social-links {
			display: none;
		}
		/* Slides in from right, starts below the header */
		.internal-links {
			position: fixed;
			top: 52px;
			right: -100%;
			width: 100%;
			height: auto;
			background: white;
			flex-direction: column;
			align-items: stretch;
			z-index: 150;
			transition: right 0.3s ease;
			overflow-y: auto;
			box-shadow: -4px 8px 24px rgba(0, 0, 0, 0.12);
		}
		.internal-links.open {
			right: 0;
		}
		.internal-links a {
			padding: 1.2rem 1.5rem;
			border-bottom: 1px solid #eee;
			font-size: 1.8rem;
			color: rgb(var(--black));
			text-decoration: none;
			display: block;
		}
		.internal-links a:hover {
			background: #f5f5f5;
			color: var(--accent);
		}
		.internal-links a.active {
			color: var(--accent);
			border-bottom: 1px solid #eee;
			border-left: 3px solid var(--accent);
		}
		.close-btn {
			display: none;
		}
		.overlay.open {
			display: block;
		}
	}
</style>

<script is:inline>
	const hamburger = document.getElementById('hamburger');
	const navMenu = document.getElementById('nav-menu');
	const overlay = document.getElementById('overlay');
	const closeBtn = document.getElementById('close-menu');

	function openMenu() {
		navMenu.classList.add('open');
		overlay.classList.add('open');
		hamburger.classList.add('menu-open');
		document.body.style.overflow = 'hidden';
	}

	function closeMenu() {
		navMenu.classList.remove('open');
		overlay.classList.remove('open');
		hamburger.classList.remove('menu-open');
		document.body.style.overflow = '';
	}

	// Toggle open/close on hamburger tap
	hamburger.addEventListener('click', () => {
		navMenu.classList.contains('open') ? closeMenu() : openMenu();
	});

	overlay.addEventListener('click', closeMenu);

	// Close when a nav link is tapped
	navMenu.querySelectorAll('a').forEach(link => {
		link.addEventListener('click', closeMenu);
	});
</script>

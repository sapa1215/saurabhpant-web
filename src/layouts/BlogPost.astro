---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
    width: 100%;
    overflow: hidden;
	}
.hero-image img {
    display: block;
    margin: 0 auto;
    border-radius: 12px;
    box-shadow: var(--box-shadow);
    max-width: 100%;
    height: auto;
    object-fit: cover;
	}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			.newsletter-section {
			background: linear-gradient(135deg, #f0f4ff 0%, #e8f5e9 100%);
			border: 1px solid #ddd;
			border-radius: 16px;
			padding: 2rem 1.5rem;
			margin: 3rem auto;
			max-width: 720px;
		}
		.newsletter-inner {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 2rem;
			align-items: center;
		}
		.newsletter-text h2 {
			font-size: 1.4rem;
			margin: 0 0 0.75rem;
			color: #1a1a2e;
		}
		.newsletter-text p {
			color: #555;
			line-height: 1.7;
			margin: 0 0 1rem;
			font-size: 0.9rem;
		}
		.newsletter-perks {
			list-style: none;
			padding: 0;
			margin: 0;
			display: flex;
			flex-direction: column;
			gap: 0.4rem;
		}
		.newsletter-perks li {
			font-size: 0.85rem;
			color: #444;
		}
		.newsletter-embed {
			display: flex;
			justify-content: center;
		}
		.newsletter-embed iframe {
			max-width: 100%;
		}
		@media (max-width: 720px) {
			.newsletter-inner {
				grid-template-columns: 1fr;
				gap: 1.5rem;
			}
		}
	@media (max-width: 720px) {
		.prose {
		width: 100%;
		padding: 0.75em;
		font-size: 0.95rem;
	}
@media (max-width: 720px) {
    .hero-image {
        margin: 0;
        border-radius: 0;
    }
    .hero-image img {
        width: 100% !important;
        height: 220px !important;
        object-fit: cover !important;
        border-radius: 0 !important;
    }
    .prose {
        width: 100% !important;
        padding: 0.75em !important;
    }
}
	.hero-image img {
		border-radius: 6px;
	}
	.newsletter-inner {
		grid-template-columns: 1fr;
	}
	.newsletter-embed iframe {
		width: 100% !important;
		height: 280px !important;
	}
}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <img width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />

				<!-- NEWSLETTER SECTION -->
				<section class="newsletter-section">
					<div class="newsletter-inner">
						<div class="newsletter-text">
							<h2>📬 Enjoyed this article?</h2>
							<p>
								Subscribe for weekly telecom insights on 5G strategy, OSS/BSS,
								MVNO business models, and digital infrastructure.
							</p>
							<ul class="newsletter-perks">
								<li>✅ Original insights from 20+ years in telecom</li>
								<li>✅ No spam, unsubscribe anytime</li>
								<li>✅ Free forever</li>
							</ul>
						</div>
						<div class="newsletter-embed">
							<iframe
								src="https://saurabhpant.substack.com/embed"
								width="480"
								height="320"
								style="border:1px solid #EEE; background:white; border-radius:8px; max-width:100%;"
								frameborder="0"
								scrolling="no">
							</iframe>
						</div>
					</div>
				</section>
			</div>
		</article>
	</main>
	<Footer />
	</body>
</html>
